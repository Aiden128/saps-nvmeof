+static inline bool
+saps_sparse_fault_mask_is_stale(uint16_t qp_id, struct nvme_bdev_channel *nbdev_ch)
+{
+	struct nvme_io_path *io_path;
+
+	STAILQ_FOREACH(io_path, &nbdev_ch->io_path_list, stailq) {
+		uint16_t path_id;
+		uint16_t fault_type;
+		uint8_t verdict;
+
+		if (io_path == NULL || io_path->qpair == NULL ||
+		    io_path->qpair->ctrlr == NULL) {
+			continue;
+		}
+
+		path_id = saps_ctrlr_to_path_idx(io_path->qpair->ctrlr->ctrlr);
+		verdict = saps_read_retry_verdict(qp_id, path_id);
+		if (verdict != DPA_SAPS_ACTION_UNSET) {
+			return false;
+		}
+
+		fault_type = saps_read_fault_type(qp_id, path_id);
+		if (fault_type != 0 && fault_type != SAPS_FAULT_SPARSE_ERROR) {
+			return false;
+		}
+	}
+
+	return true;
+}
