+static inline uint32_t
+saps_d8_sane_slow_capacity(uint32_t fast_cap, uint32_t slow_cap)
+{
+	uint64_t min_cap;
+	uint64_t max_cap;
+
+	if (fast_cap == 0) {
+		fast_cap = 1024u;
+	}
+	min_cap = ((uint64_t)fast_cap * 3u + 7u) / 8u;
+	max_cap = ((uint64_t)fast_cap * 2u + 2u) / 3u;
+	if (min_cap == 0) {
+		min_cap = 1;
+	}
+	if (max_cap < min_cap) {
+		max_cap = min_cap;
+	}
+	if (slow_cap < min_cap || slow_cap > max_cap) {
+		slow_cap = fast_cap / 2u;
+		if (slow_cap == 0) {
+			slow_cap = 1;
+		}
+	}
+
+	return slow_cap;
+}
