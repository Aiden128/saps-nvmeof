+static int
+bdev_nvme_hedge_submit_req(struct nvme_bdev_io *bio, struct nvme_bdev_hedge_req *req,
+			   struct iovec *iov, int iovcnt, uint64_t lba_count, uint64_t lba)
+{
+	struct spdk_nvme_ns *ns = req->io_path->nvme_ns->ns;
+	struct spdk_nvme_qpair *qpair = req->io_path->qpair->qpair;
+	int rc;
+
+	rc = spdk_nvme_ns_cmd_read_iov(ns, qpair, lba, lba_count,
+				       bdev_nvme_hedge_read_done, req,
+				       iov, iovcnt, &bio->ext_opts);
+	if (rc == 0) {
+		req->submitted = true;
+	}
+	return rc;
+}
+
+static int
+bdev_nvme_hedged_readv(struct nvme_bdev_io *bio, struct iovec *iov, int iovcnt,
+		       void *md, uint64_t lba_count, uint64_t lba, uint32_t flags,
+		       struct spdk_memory_domain *domain, void *domain_ctx,
+		       struct spdk_accel_sequence *seq)
+{
+	struct nvme_bdev_hedge_ctx *ctx;
+	int rc;
+
+	if (bio->hedge_io_path == NULL || bio->hedge_io_path == bio->io_path ||
+	    !nvme_io_path_is_available(bio->io_path) ||
+	    !nvme_io_path_is_available(bio->hedge_io_path)) {
+		return bdev_nvme_readv(bio, iov, iovcnt, md, lba_count, lba, flags,
+				       domain, domain_ctx, seq);
+	}
+
+	ctx = calloc(1, sizeof(*ctx));
+	if (ctx == NULL) {
+		return bdev_nvme_readv(bio, iov, iovcnt, md, lba_count, lba, flags,
+				       domain, domain_ctx, seq);
+	}
+
+	ctx->owner_bio = bio;
+	ctx->primary.ctx = ctx;
+	ctx->primary.io_path = bio->io_path;
+	ctx->primary.abort_done = true;
+	ctx->twin.ctx = ctx;
+	ctx->twin.io_path = bio->hedge_io_path;
+	ctx->twin.abort_done = true;
+	bio->hedge_twin = ctx;
+
+	bio->ext_opts.size = SPDK_SIZEOF(&bio->ext_opts, accel_sequence);
+	bio->ext_opts.memory_domain = domain;
+	bio->ext_opts.memory_domain_ctx = domain_ctx;
+	bio->ext_opts.io_flags = flags;
+	bio->ext_opts.metadata = md;
+	bio->ext_opts.apptag_mask = 0;
+	bio->ext_opts.apptag = 0;
+	bio->ext_opts.cdw13 = 0;
+	bio->ext_opts.accel_sequence = seq;
+
+	rc = bdev_nvme_hedge_submit_req(bio, &ctx->primary, iov, iovcnt, lba_count, lba);
+	if (spdk_unlikely(rc != 0)) {
+		bio->hedge_twin = NULL;
+		free(ctx);
+		return rc;
+	}
+
+	rc = bdev_nvme_hedge_submit_req(bio, &ctx->twin, iov, iovcnt, lba_count, lba);
+	if (spdk_unlikely(rc != 0)) {
+		ctx->twin.completed = true;
+		ctx->twin.abort_done = true;
+	}
+
+	return 0;
+}
