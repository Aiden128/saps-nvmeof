+static inline struct nvme_io_path *
+saps_try_healthy_bypass(struct nvme_bdev_channel *nbdev_ch,
+			struct saps_io_selection *selection)
+{
+	struct nvme_io_path *io_path;
+	uint64_t now = spdk_get_ticks();
+	uint64_t cache_ttl;
+
+	if (host_saps_active()) {
+		return NULL;
+	}
+	/* SAPS-Q (throughput-ceiling fix, 2026-05-29): the 2026-05-24 change
+	 * disabled the healthy bypass for SAPS-Q on the theory that
+	 * dpa_plugin_select_io_path would distribute traffic across paths 0/1/2.
+	 * Measurement disproved that: the per-IO scoring selector concentrates
+	 * IO and caps multi-tenant aggregate at ~0.86M, whereas stock round-robin
+	 * path selection (_bdev_nvme_find_io_path) with the SAPS-Q admission token
+	 * bucket still in force reaches ~1.87M (2.2x) on the same testbed.  The
+	 * bypass below already round-robins across optimized paths when healthy AND
+	 * returns NULL (→ scoring selector) the moment any path carries a fault
+	 * mask (see the per-path check further down), so re-enabling it for SAPS-Q
+	 * restores healthy-case throughput while preserving fault steering for
+	 * D1/D3.  The earlier "always returns path 0" symptom was the stale
+	 * current_io_path under mp_policy=plugin; the per-path fault gate makes the
+	 * healthy fast path safe to use here. */
+	if (saps_d8_proportional_enabled()) {
+		return NULL;
+	}
+	if (saps_disable_healthy_bypass()) {
+		return NULL;
+	}
+	if (saps_any_retry_suppressed(nbdev_ch, now)) {
+		nbdev_ch->saps_healthy_bypass_cache_until_tsc = 0;
+		nbdev_ch->saps_healthy_bypass_cache_allow = false;
+		return NULL;
+	}
+	if (nbdev_ch->saps_healthy_bypass_cache_allow &&
+	    now < nbdev_ch->saps_healthy_bypass_cache_until_tsc) {
+		struct nvme_io_path *picked = _bdev_nvme_find_io_path(nbdev_ch);
+
+		if (selection != NULL) {
+			selection->primary = picked;
+			selection->hedge = NULL;
+		}
+		dpa_plugin_note_healthy_full_bypass();
+		return picked;
+	}
+
+	nbdev_ch->saps_healthy_bypass_cache_allow = false;
+	nbdev_ch->saps_healthy_bypass_cache_until_tsc = 0;
+	cache_ttl = spdk_get_ticks_hz() / 1000ull;
+	if (spdk_unlikely(cache_ttl == 0)) {
+		cache_ttl = 1;
+	}
+
+	/* Phase 1 (C1 fix, 2026-05-30): scan ALL paths first.  Any retry-suppressed
+	 * or active-non-stale fault mask on ANY path bails out to NULL (→ scoring
+	 * selector for fault steering).  The old single-pass loop returned the
+	 * round-robin pick as soon as the FIRST path looked healthy, so a faulted
+	 * path later in io_path_list would have been silently round-robin'd onto;
+	 * it only happened to be safe because all 3 testbed paths share qpair->id=1
+	 * (so the first fault-mask read was quasi-global).  Two-phase makes it
+	 * correct for distinct qp_ids without changing observable D1/D3 behaviour. */
+	STAILQ_FOREACH(io_path, &nbdev_ch->io_path_list, stailq) {
+		struct spdk_nvme_qpair *spdk_qp = io_path->qpair->qpair;
+		uint16_t qp_id;
+		uint16_t path_id;
+
+		if (spdk_qp == NULL) {
+			continue;
+		}
+
+		qp_id = spdk_nvme_qpair_get_id(spdk_qp);
+		path_id = saps_ctrlr_to_path_idx(io_path->qpair->ctrlr->ctrlr);
+		if (saps_retry_suppressed(nbdev_ch, path_id, now)) {
+			nbdev_ch->saps_healthy_bypass_cache_until_tsc = 0;
+			nbdev_ch->saps_healthy_bypass_cache_allow = false;
+			return NULL;
+		}
+		if (dpa_plugin_read_qp_fault_mask(qp_id) != 0 &&
+		    !saps_sparse_fault_mask_is_stale(qp_id, nbdev_ch)) {
+			return NULL;
+		}
+	}
+
+	/* Phase 2: all paths healthy → set bypass cache + round-robin pick. */
+	{
+		struct nvme_io_path *picked = _bdev_nvme_find_io_path(nbdev_ch);
+		if (selection != NULL) {
+			selection->primary = picked;
+			selection->hedge = NULL;
+		}
+		nbdev_ch->saps_healthy_bypass_cache_allow = true;
+		nbdev_ch->saps_healthy_bypass_cache_until_tsc = now + cache_ttl;
+		dpa_plugin_note_healthy_full_bypass();
+		return picked;
+	}
+}
+#endif
+
+static inline struct nvme_io_path *
+dpa_plugin_select_io_path(struct nvme_bdev_channel *nbdev_ch,
+			  const struct spdk_bdev_io *bdev_io,
+			  struct saps_io_selection *selection)
+{
+	g_dpa_plugin_select_count++;
+	if (g_dpa_plugin_select_count == 1 || g_dpa_plugin_select_count == 100 ||
+	    g_dpa_plugin_select_count == 10000 || g_dpa_plugin_select_count == 1000000) {
+		fprintf(stderr, "D4_SEL_ENTRY count=%lu mp_policy=%d mp_selector=%d\n",
+			(unsigned long)g_dpa_plugin_select_count,
+			(int)nbdev_ch->mp_policy, (int)nbdev_ch->mp_selector);
+	}
+	if (selection != NULL) {
+		selection->primary = NULL;
+		selection->hedge = NULL;
+	}
+
+#ifdef DPA_PLUGIN_ENABLED
+	struct nvme_io_path *io_path;
+	struct saps_path_slot {
+		struct nvme_io_path *io_path;
+		uint32_t final_score;
+		uint32_t host_qd_score;
+		uint32_t opc_p99;
+		uint32_t capacity;
+		uint32_t inflight;
+		uint32_t quota;
+		uint8_t unsampled;
+		uint8_t probe_limited;
+		uint16_t fault_type;
+		uint16_t state;
+		uint16_t path_id;
+	};
+	struct saps_path_slot slots[8];
+	uint32_t sapsq_budget_q32[SPDK_COUNTOF(slots)] = {0};
+	unsigned n_slots = 0;
+	unsigned n_unsampled = 0;
+	bool proportional_mode = false;
+	uint64_t total_weight = 0;
+	uint8_t opcode_class = 0;
+		bool use_opcode_score = saps_bdev_io_opcode_class(bdev_io, &opcode_class);
+		bool hedge_eligible = saps_bdev_io_hedge_select_eligible(bdev_io);
+		bool d8_proportional_mode = saps_d8_proportional_enabled();
+		uint32_t min_opc_p99 = UINT32_MAX;
+		struct nvme_io_path *healthy_bypass_path;
+		struct nvme_io_path *retry_bypass_path;
+		uint64_t now;
+
+#define SAPS_RETURN_SLOT(_idx) do {						\
+		unsigned _slot_idx = (_idx);					\
+		if (saps_d8_proportional_enabled() &&				\
+		    saps_d8_debug_select_enabled() &&				\
+		    (g_dpa_plugin_select_count % 100u) == 0) {			\
+			uint32_t _cap[3] = {0}, _quota[3] = {0}, _inflight[3] = {0}; \
+			uint16_t _fault[3] = {0};				\
+			for (unsigned _j = 0; _j < n_slots; _j++) {		\
+				uint16_t _path = slots[_j].path_id;		\
+				if (_path < 3u) {				\
+					_cap[_path] = slots[_j].capacity;	\
+					_quota[_path] = slots[_j].quota;	\
+					_inflight[_path] = slots[_j].inflight;	\
+					_fault[_path] = slots[_j].fault_type;	\
+				}						\
+			}							\
+			fprintf(stderr,						\
+				"SAPS_D8_PROP_SELECT count=%lu selected_path=%u " \
+				"n_slots=%u proportional=%u n_unsampled=%u "	\
+				"capacity_a=%u capacity_b=%u capacity_c=%u "	\
+				"quota_a=%u quota_b=%u quota_c=%u "		\
+				"inflight_a=%u inflight_b=%u inflight_c=%u "	\
+				"fault_a=%u fault_b=%u fault_c=%u\n",		\
+				(unsigned long)g_dpa_plugin_select_count,	\
+				slots[_slot_idx].path_id, n_slots,		\
+				proportional_mode ? 1u : 0u, n_unsampled,	\
+				_cap[0], _cap[1], _cap[2],			\
+				_quota[0], _quota[1], _quota[2],		\
+				_inflight[0], _inflight[1], _inflight[2],	\
+				_fault[0], _fault[1], _fault[2]);		\
+		}								\
+		if (selection != NULL) {					\
+			selection->primary = slots[_slot_idx].io_path;		\
+			selection->hedge = NULL;				\
+			if (hedge_eligible &&					\
+			    slots[_slot_idx].fault_type == SAPS_FAULT_BIMODAL_TAIL) { \
+				unsigned _best = SPDK_COUNTOF(slots);		\
+				uint32_t _best_score = 0;			\
+				for (unsigned _j = 0; _j < n_slots; _j++) {	\
+					if (_j == _slot_idx ||			\
+					    slots[_j].fault_type == SAPS_FAULT_BIMODAL_TAIL) { \
+						continue;			\
+					}					\
+					if (!slots[_j].unsampled &&		\
+					    (_best == SPDK_COUNTOF(slots) ||	\
+					     slots[_j].final_score > _best_score)) { \
+						_best = _j;			\
+						_best_score = slots[_j].final_score; \
+					}					\
+				}						\
+				if (_best == SPDK_COUNTOF(slots)) {		\
+					for (unsigned _j = 0; _j < n_slots; _j++) { \
+						if (_j == _slot_idx ||		\
+						    slots[_j].fault_type == SAPS_FAULT_BIMODAL_TAIL) { \
+							continue;		\
+						}				\
+						if (_best == SPDK_COUNTOF(slots) || \
+						    slots[_j].final_score > _best_score) { \
+							_best = _j;		\
+							_best_score = slots[_j].final_score; \
+						}				\
+					}					\
+				}						\
+				if (_best != SPDK_COUNTOF(slots)) {		\
+					selection->hedge = slots[_best].io_path;	\
+				}						\
+			}							\
+		}								\
+		return slots[_slot_idx].io_path;				\
+	} while (0)
+
+		now = spdk_get_ticks();
+		if (saps_any_retry_suppressed(nbdev_ch, now)) {
+			nbdev_ch->saps_healthy_bypass_cache_until_tsc = 0;
+			nbdev_ch->saps_healthy_bypass_cache_allow = false;
+			retry_bypass_path = saps_find_unsuppressed_io_path(nbdev_ch, now);
+			if (retry_bypass_path != NULL) {
+				if (selection != NULL) {
+					selection->primary = retry_bypass_path;
+					selection->hedge = NULL;
+				}
+				return retry_bypass_path;
+			}
+		}
+
+		/* D5: skip the healthy bypass (stock round-robin, opcode-blind) for the
+		 * minority opcode that needs per-opcode steering -- writes -- so they fall
+		 * through to the per-opcode gate below and avoid an opcode-slow path whose
+		 * aggregate health is fine (the write-slow path is not fault-masked, so the
+		 * bypass would otherwise stock-round-robin writes straight onto it). Reads
+		 * keep the fast bypass (the read-slow path IS fault-masked, so reads already
+		 * bail to the gate). */
+		if (!(use_opcode_score && opcode_class == 1u)) {
+			healthy_bypass_path = saps_try_healthy_bypass(nbdev_ch, selection);
+			if (healthy_bypass_path != NULL) {
+				return healthy_bypass_path;
+			}
+		}
+
+	{
+		uint16_t last_prefetched_qp = UINT16_MAX;
+
+		STAILQ_FOREACH(io_path, &nbdev_ch->io_path_list, stailq) {
+			struct spdk_nvme_qpair *spdk_qp = io_path->qpair->qpair;
+			if (spdk_qp != NULL) {
+				uint16_t prefetch_qp = spdk_nvme_qpair_get_id(spdk_qp);
+
+				if (prefetch_qp != last_prefetched_qp) {
+					saps_prefetch_path_score_row(prefetch_qp);
+					last_prefetched_qp = prefetch_qp;
+				}
+			}
+		}
+	}
+
+		STAILQ_FOREACH(io_path, &nbdev_ch->io_path_list, stailq) {
+			struct spdk_nvme_qpair *spdk_qp = io_path->qpair->qpair;
+			uint16_t qp_id, path_id, fault_type, state;
+		uint32_t dpa_score, inflight, host_qd_score, final_score, opc_p99, capacity;
+		struct dpa_plugin_path_snapshot snapshot;
+
+		if (spdk_qp == NULL || n_slots == SPDK_COUNTOF(slots)) {
+			continue;
+		}
+
+		qp_id = spdk_nvme_qpair_get_id(spdk_qp);
+		path_id = saps_ctrlr_to_path_idx(io_path->qpair->ctrlr->ctrlr);
+		if (saps_retry_suppressed(nbdev_ch, path_id, now)) {
+			continue;
+		}
+		if (!host_saps_active() &&
+		    dpa_plugin_read_path_snapshot(qp_id, path_id, opcode_class,
+						  use_opcode_score ? 1u : 0u,
+						  d8_proportional_mode ? 1u : 0u,
+						  &snapshot)) {
+			dpa_score = use_opcode_score ? snapshot.opcode_score : 0;
+			opc_p99 = use_opcode_score ? snapshot.opc_p99 : 0;
+			if (dpa_score == 0) {
+				dpa_score = snapshot.score;
+			}
+			fault_type = snapshot.fault_type;
+			state = snapshot.state;
+			capacity = snapshot.capacity;
+		} else {
+			dpa_score = use_opcode_score ?
+					saps_read_score_opcode(qp_id, path_id, opcode_class) : 0;
+			opc_p99 = use_opcode_score ?
+					saps_read_opc_p99(qp_id, path_id, opcode_class) : 0;
+			if (dpa_score == 0) {
+				dpa_score = saps_read_score(qp_id, path_id);
+			}
+			fault_type = saps_read_fault_type(qp_id, path_id);
+			state = dpa_plugin_read_path_state(qp_id, path_id);
+			capacity = d8_proportional_mode ||
+				   fault_type == SAPS_FAULT_PROPORTIONAL_THROTTLE ?
+				   saps_read_capacity(qp_id, path_id) : 0;
+		}
+		inflight = spdk_nvme_qpair_get_num_outstanding_reqs(spdk_qp);
+		host_qd_score = inflight < MAX_QD_REASONABLE ?
+				MAX_QD_REASONABLE - inflight : 1u;
+
+			if (dpa_score == 0) {
+				final_score = host_qd_score;
+			} else if (dpa_score == SAPS_SCORE_MIN) {
+				final_score = 1u;
+			} else {
+				uint32_t norm = dpa_score >> 4; /* Q4.20 -> Q0.16 */
+				final_score = host_qd_score * (norm == 0 ? 1u : norm);
+			}
+
+			slots[n_slots].io_path = io_path;
+			slots[n_slots].final_score = final_score;
+			slots[n_slots].host_qd_score = host_qd_score;
+			slots[n_slots].opc_p99 = opc_p99;
+			slots[n_slots].capacity = capacity;
+			slots[n_slots].inflight = inflight;
+			slots[n_slots].quota = 0;
+			slots[n_slots].unsampled = dpa_score == 0;
+			slots[n_slots].probe_limited =
+				dpa_score != 0 &&
+				(dpa_score <= 16u ||
+				 saps_state_needs_active_probe(state) ||
+				 saps_fault_needs_active_probe(fault_type));
+			slots[n_slots].fault_type = fault_type;
+			slots[n_slots].state = state;
+			slots[n_slots].path_id = path_id;
+				if (fault_type == SAPS_FAULT_PROPORTIONAL_THROTTLE) {
+					proportional_mode = true;
+				}
+				n_unsampled += dpa_score == 0;
+				n_slots++;
+		}
+
+		/* SAPS-Q computes a committed rate for each (tenant, path), and the
+		 * RDMA admission hook enforces that same row after path selection.
+		 * Choose in proportion to those rates so the selector does not drain a
+		 * path independently and leave committed capacity unused. Before the
+		 * first committed epoch, retain the existing selector for bootstrap. */
+	{
+		int budget_paths = sapsq_bypass_budget_selection()
+				   ? 0
+				   : dpa_plugin_read_sapsq_budget_row(
+					   sapsq_budget_q32,
+					   SPDK_COUNTOF(sapsq_budget_q32));
+		uint64_t budget_sum = 0;
+		uint64_t selectable_budget_sum = 0;
+		uint32_t probe_budget_q32 =
+			dpa_plugin_read_sapsq_probe_rate_q32();
+		bool budget_selectable[SPDK_COUNTOF(slots)] = {false};
+
+		if (budget_paths > 0) {
+			for (unsigned i = 0; i < n_slots; i++) {
+				uint16_t path_id = slots[i].path_id;
+
+				if (path_id < (uint16_t)budget_paths) {
+					budget_sum += sapsq_budget_q32[path_id];
+				}
+			}
+		}
+
+		if (budget_sum != 0) {
+			for (unsigned i = 0; i < n_slots; i++) {
+				uint16_t path_id = slots[i].path_id;
+
+				if (path_id >= (uint16_t)budget_paths ||
+				    sapsq_budget_q32[path_id] == 0) {
+					continue;
+				}
+				/*
+				 * Select in proportion to the committed rate.  A QD share
+				 * is not a rate share when paths have different latency:
+				 * capping inflight by the rate ratio can make the selector
+				 * deliver less than the committed budget.  The per-path
+				 * token bucket is the rate-enforcement boundary.  Only a
+				 * row reduced to the explicit probe budget receives an
+				 * inflight cap, preventing a very slow probe path from
+				 * occupying the full application queue.
+				 */
+				if (probe_budget_q32 != 0 &&
+				    sapsq_budget_q32[path_id] <= probe_budget_q32 &&
+				    slots[i].inflight >= SAPS_PROBE_MAX_INFLIGHT) {
+					continue;
+				}
+				budget_selectable[i] = true;
+				selectable_budget_sum += sapsq_budget_q32[path_id];
+			}
+		}
+
+		if (selectable_budget_sum != 0) {
+			uint64_t r =
+				saps_xorshift32(&nbdev_ch->rr_counter) %
+				selectable_budget_sum;
+			uint64_t acc = 0;
+			uint64_t trace_stride = 0;
+			bool trace_budget =
+				saps_selector_trace_enabled(&trace_stride) &&
+				trace_stride != 0 &&
+				(g_dpa_plugin_select_count % trace_stride) == 0;
+
+			for (unsigned i = 0; i < n_slots; i++) {
+				uint16_t path_id = slots[i].path_id;
+
+				if (!budget_selectable[i]) {
+					continue;
+				}
+				acc += sapsq_budget_q32[path_id];
+				if (acc > r) {
+					if (trace_budget) {
+						fprintf(stderr,
+							"SAPSQ_BUDGET_SELECT count=%lu selected_path=%u "
+							"budget_paths=%d n_slots=%u budget_sum=%lu "
+							"selectable_budget_sum=%lu selected_inflight=%u "
+							"probe_budget=%u budget_a=%u budget_b=%u "
+							"budget_c=%u\n",
+							(unsigned long)g_dpa_plugin_select_count,
+							path_id, budget_paths, n_slots,
+							(unsigned long)budget_sum,
+							(unsigned long)selectable_budget_sum,
+							slots[i].inflight,
+							probe_budget_q32,
+							sapsq_budget_q32[0],
+							sapsq_budget_q32[1],
+							sapsq_budget_q32[2]);
+					}
+					SAPS_RETURN_SLOT(i);
+				}
+			}
+		}
+	}
+
+		if (d8_proportional_mode && n_slots > 0) {
+			uint32_t slow_path = saps_d8_slow_path_id();
+			uint32_t fast_cap = saps_d8_fast_capacity();
+			uint32_t slow_cap = saps_d8_sane_slow_capacity(fast_cap,
+									saps_d8_slow_capacity());
+
+			if (fast_cap == 0) {
+				fast_cap = 1024u;
+			}
+
+			proportional_mode = true;
+			n_unsampled = 0;
+			for (unsigned i = 0; i < n_slots; i++) {
+				uint32_t cap;
+
+				if (slots[i].path_id == slow_path) {
+					cap = slow_cap;
+					slots[i].fault_type = SAPS_FAULT_PROPORTIONAL_THROTTLE;
+				} else {
+					cap = fast_cap;
+					slots[i].fault_type = 0;
+				}
+
+				slots[i].capacity = cap;
+				slots[i].final_score = cap;
+				slots[i].unsampled = 0;
+				slots[i].probe_limited = 0;
+			}
+		}
+
+		{
+			uint64_t trace_stride;
+
+			if (saps_selector_trace_enabled(&trace_stride) &&
+			    trace_stride != 0 && (g_dpa_plugin_select_count % trace_stride) == 0) {
+				fprintf(stderr,
+					"SAPS_SELECTOR_PRE count=%lu n_slots=%u n_unsampled=%u proportional=%u\n",
+					(unsigned long)g_dpa_plugin_select_count,
+					n_slots, n_unsampled, proportional_mode ? 1u : 0u);
+				for (unsigned i = 0; i < n_slots; i++) {
+					fprintf(stderr,
+						"SAPS_SELECTOR_PRE_SLOT count=%lu i=%u path_id=%u score=%u "
+						"capacity=%u inflight=%u fault=%u unsampled=%u probe=%u\n",
+						(unsigned long)g_dpa_plugin_select_count, i,
+						slots[i].path_id, slots[i].final_score,
+						slots[i].capacity, slots[i].inflight,
+						slots[i].fault_type, slots[i].unsampled,
+						slots[i].probe_limited);
+				}
+			}
+		}
+
+		if (n_slots > 0 && n_unsampled == 0) {
+			bool all_degraded = true;
+
+			for (unsigned i = 0; i < n_slots; i++) {
+				if (slots[i].fault_type != SAPS_FAULT_ALL_DEGRADED) {
+					all_degraded = false;
+					break;
+				}
+			}
+			if (all_degraded) {
+				unsigned pick = ++nbdev_ch->rr_counter % n_slots;
+
+				SAPS_RETURN_SLOT(pick);
+			}
+		}
+
+		if (n_slots > 0 && n_unsampled == 0 && !proportional_mode) {
+			uint32_t cap_min = 0xFFFFFFFFu, cap_max = 0;
+			uint32_t infl_min = 0xFFFFFFFFu, infl_max = 0;
+			unsigned cap_valid = 0;
+
+			for (unsigned i = 0; i < n_slots; i++) {
+				if (slots[i].capacity != 0) {
+					if (slots[i].capacity < cap_min) {
+						cap_min = slots[i].capacity;
+					}
+					if (slots[i].capacity > cap_max) {
+						cap_max = slots[i].capacity;
+					}
+					cap_valid++;
+				}
+				if (slots[i].inflight < infl_min) {
+					infl_min = slots[i].inflight;
+				}
+				if (slots[i].inflight > infl_max) {
+					infl_max = slots[i].inflight;
+				}
+			}
+
+			if (cap_valid >= 2 && cap_min != 0 &&
+			    (uint64_t)cap_max * 4u > (uint64_t)cap_min * 5u) {
+				proportional_mode = true;
+			} else if (infl_max >= 4u &&
+				   (uint64_t)infl_max >= (uint64_t)(infl_min == 0 ? 1 : infl_min) * 2u) {
+				uint32_t ref = infl_min == 0 ? 1u : infl_min;
+
+				proportional_mode = true;
+				for (unsigned i = 0; i < n_slots; i++) {
+					uint32_t infl = slots[i].inflight == 0 ? 1u : slots[i].inflight;
+					uint32_t cap = (uint32_t)(((uint64_t)1024u * ref) / infl);
+
+					if (cap > 1024u) {
+						cap = 1024u;
+					}
+					if (cap < 512u) {
+						cap = 512u;
