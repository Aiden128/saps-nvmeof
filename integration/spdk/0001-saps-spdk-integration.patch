+static inline uint32_t
+saps_env_u32_cached(const char *name, uint32_t fallback, uint32_t floor,
+		    uint32_t slot)
+{
+	static int initialized[4];
+	static uint32_t cached[4];
+
+	if (slot >= SPDK_COUNTOF(initialized)) {
+		return fallback;
+	}
+	if (!initialized[slot]) {
+		const char *env = getenv(name);
+		uint32_t value = fallback;
+
+		if (env != NULL && env[0] != '\0') {
+			char *end = NULL;
+			unsigned long parsed = strtoul(env, &end, 10);
+
+			if (end != env && parsed <= UINT32_MAX) {
+				value = (uint32_t)parsed;
+			}
+		}
+		if (value < floor) {
+			value = floor;
+		}
+		cached[slot] = value;
+		initialized[slot] = 1;
+	}
+
+	return cached[slot];
+}
