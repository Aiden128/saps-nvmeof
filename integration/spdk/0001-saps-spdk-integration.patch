@@ -450,6 +450,16 @@ vbdev_delay_submit_request(struct spdk_io_channel *ch, struct spdk_bdev_io *bdev
 	case SPDK_BDEV_IO_TYPE_ABORT:
 		rc = vbdev_delay_abort(delay_node, delay_ch, bdev_io);
 		break;
+	case SPDK_BDEV_IO_TYPE_NVME_ADMIN:
+		/* Passthrough admin IOs (e.g. NVMe-oF Fabric Connect) without delay.
+		 * bdev_delay only intercepts data-path IOs (read/write); admin commands
+		 * must succeed for the initiator to establish a connection. */
+		rc = spdk_bdev_nvme_admin_passthru(delay_node->base_desc, delay_ch->base_ch,
+						   &bdev_io->u.nvme_passthru.cmd,
+						   bdev_io->u.nvme_passthru.buf,
+						   bdev_io->u.nvme_passthru.nbytes,
+						   _delay_complete_io, bdev_io);
+		break;
 	case SPDK_BDEV_IO_TYPE_ZCOPY:
 		if (bdev_io->u.bdev.zcopy.commit) {
 			io_ctx->type = is_p99 ? DELAY_P99_WRITE : DELAY_AVG_WRITE;
@@ -488,6 +498,14 @@ vbdev_delay_io_type_supported(void *ctx, enum spdk_bdev_io_type io_type)
 {
 	struct vbdev_delay *delay_node = (struct vbdev_delay *)ctx;
 
+	/* Do not advertise NVME_ADMIN support.  If we advertise it, nvmf_tgt will
+	 * passthrough IDENTIFY NAMESPACE to the underlying NVMe SSD, which may
+	 * return INVALID NAMESPACE OR FORMAT and break NVMe-oF connections.
+	 * nvmf_tgt handles IDENTIFY NAMESPACE itself when this returns false. */
+	if (io_type == SPDK_BDEV_IO_TYPE_NVME_ADMIN) {
+		return false;
+	}
+
 	return spdk_bdev_io_type_supported(delay_node->base_bdev, io_type);
 }
 
