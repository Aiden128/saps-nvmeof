+static struct nvme_io_path *
+saps_find_unsuppressed_io_path(struct nvme_bdev_channel *nbdev_ch, uint64_t now)
+{
+	struct nvme_io_path *io_path, *start, *non_optimized = NULL;
+
+	start = nvme_io_path_get_next(nbdev_ch, nbdev_ch->current_io_path);
+	if (start == NULL) {
+		return NULL;
+	}
+
+	io_path = start;
+	do {
+		uint16_t path_id;
+
+		if (io_path == NULL || io_path->qpair == NULL ||
+		    io_path->qpair->ctrlr == NULL) {
+			goto next;
+		}
+		if (spdk_unlikely(!nvme_io_path_is_available(io_path))) {
+			goto next;
+		}
+
+		path_id = saps_ctrlr_to_path_idx(io_path->qpair->ctrlr->ctrlr);
+		if (saps_retry_suppressed(nbdev_ch, path_id, now)) {
+			goto next;
+		}
+
+		switch (io_path->nvme_ns->ana_state) {
+		case SPDK_NVME_ANA_OPTIMIZED_STATE:
+			nbdev_ch->current_io_path = io_path;
+			return io_path;
+		case SPDK_NVME_ANA_NON_OPTIMIZED_STATE:
+			if (non_optimized == NULL) {
+				non_optimized = io_path;
+			}
+			break;
+		default:
+			assert(false);
+			break;
+		}
+
+next:
+		io_path = nvme_io_path_get_next(nbdev_ch, io_path);
+	} while (io_path != start);
+
+	nbdev_ch->current_io_path = non_optimized;
+	return non_optimized;
+}
