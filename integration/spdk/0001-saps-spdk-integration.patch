diff --git a/module/bdev/bimodal_delay/vbdev_bimodal_delay_rpc.c b/module/bdev/bimodal_delay/vbdev_bimodal_delay_rpc.c
new file mode 100644
index 000000000..307be8cc2
--- /dev/null
+++ b/module/bdev/bimodal_delay/vbdev_bimodal_delay_rpc.c
@@ -0,0 +1,168 @@
+/*   SPDX-License-Identifier: BSD-3-Clause
+ *   RPC handlers for bdev_bimodal_delay_create / _update / _delete.
+ */
+
+#include "spdk/stdinc.h"
+#include "spdk/rpc.h"
+#include "spdk/util.h"
+#include "spdk/string.h"
+#include "spdk/log.h"
+#include "vbdev_bimodal_delay.h"
+
+/* ---- bdev_bimodal_delay_create ---- */
+struct rpc_bimodal_create {
+	char		*base_bdev_name;
+	char		*name;
+	struct spdk_uuid uuid;
+	uint64_t	fast_lat_us;
+	uint64_t	slow_lat_us;
+	uint32_t	p_slow_ppm;  /* optional, default 150000 (15%) */
+};
+
+static void
+free_rpc_bimodal_create(struct rpc_bimodal_create *r)
+{
+	free(r->base_bdev_name);
+	free(r->name);
+}
+
+static const struct spdk_json_object_decoder rpc_bdev_bimodal_delay_create_decoders[] = {
+	{"base_bdev_name", offsetof(struct rpc_bimodal_create, base_bdev_name), spdk_json_decode_string},
+	{"name",           offsetof(struct rpc_bimodal_create, name),           spdk_json_decode_string},
+	{"uuid",           offsetof(struct rpc_bimodal_create, uuid),           spdk_json_decode_uuid, true},
+	{"fast_lat_us",    offsetof(struct rpc_bimodal_create, fast_lat_us),    spdk_json_decode_uint64},
+	{"slow_lat_us",    offsetof(struct rpc_bimodal_create, slow_lat_us),    spdk_json_decode_uint64},
+	{"p_slow_ppm",     offsetof(struct rpc_bimodal_create, p_slow_ppm),     spdk_json_decode_uint32, true},
+};
+
+static void
+rpc_bdev_bimodal_delay_create(struct spdk_jsonrpc_request *request,
+			      const struct spdk_json_val *params)
+{
+	struct rpc_bimodal_create req = {.p_slow_ppm = 150000};
+	struct spdk_json_write_ctx *w;
+	int rc;
+
+	if (spdk_json_decode_object(params, rpc_bdev_bimodal_delay_create_decoders,
+				    SPDK_COUNTOF(rpc_bdev_bimodal_delay_create_decoders), &req)) {
+		SPDK_ERRLOG("bimodal_delay: spdk_json_decode_object failed\n");
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INTERNAL_ERROR,
+						 "spdk_json_decode_object failed");
+		goto cleanup;
+	}
+
+	rc = create_bimodal_delay_disk(req.base_bdev_name, req.name, &req.uuid,
+				       req.fast_lat_us, req.slow_lat_us, req.p_slow_ppm);
+	if (rc != 0) {
+		spdk_jsonrpc_send_error_response(request, rc, spdk_strerror(-rc));
+		goto cleanup;
+	}
+
+	w = spdk_jsonrpc_begin_result(request);
+	spdk_json_write_string(w, req.name);
+	spdk_jsonrpc_end_result(request, w);
+
+cleanup:
+	free_rpc_bimodal_create(&req);
+}
+SPDK_RPC_REGISTER("bdev_bimodal_delay_create", rpc_bdev_bimodal_delay_create, SPDK_RPC_RUNTIME)
+
+/* ---- bdev_bimodal_delay_update ---- */
+struct rpc_bimodal_update {
+	char		*name;
+	uint64_t	fast_lat_us;
+	uint64_t	slow_lat_us;
+	uint32_t	p_slow_ppm;
+};
+
+static void
+free_rpc_bimodal_update(struct rpc_bimodal_update *r)
+{
+	free(r->name);
+}
+
+static const struct spdk_json_object_decoder rpc_bdev_bimodal_delay_update_decoders[] = {
+	{"name",        offsetof(struct rpc_bimodal_update, name),        spdk_json_decode_string},
+	{"fast_lat_us", offsetof(struct rpc_bimodal_update, fast_lat_us), spdk_json_decode_uint64, true},
+	{"slow_lat_us", offsetof(struct rpc_bimodal_update, slow_lat_us), spdk_json_decode_uint64, true},
+	{"p_slow_ppm",  offsetof(struct rpc_bimodal_update, p_slow_ppm),  spdk_json_decode_uint32, true},
+};
+
+static void
+rpc_bdev_bimodal_delay_update(struct spdk_jsonrpc_request *request,
+			      const struct spdk_json_val *params)
+{
+	struct rpc_bimodal_update req = {.p_slow_ppm = UINT32_MAX};
+	int rc;
+
+	if (spdk_json_decode_object(params, rpc_bdev_bimodal_delay_update_decoders,
+				    SPDK_COUNTOF(rpc_bdev_bimodal_delay_update_decoders), &req)) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INTERNAL_ERROR,
+						 "spdk_json_decode_object failed");
+		goto cleanup;
+	}
+
+	rc = update_bimodal_delay_disk(req.name, req.fast_lat_us, req.slow_lat_us, req.p_slow_ppm);
+	if (rc == -ENODEV) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INVALID_PARAMS,
+						 "bdev not found");
+	} else if (rc == -EINVAL) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INVALID_PARAMS,
+						 "p_slow_ppm must be <= 1000000");
+	} else if (rc != 0) {
+		spdk_jsonrpc_send_error_response(request, rc, spdk_strerror(-rc));
+	} else {
+		spdk_jsonrpc_send_bool_response(request, true);
+	}
+
+cleanup:
+	free_rpc_bimodal_update(&req);
+}
+SPDK_RPC_REGISTER("bdev_bimodal_delay_update", rpc_bdev_bimodal_delay_update, SPDK_RPC_RUNTIME)
+
+/* ---- bdev_bimodal_delay_delete ---- */
+struct rpc_bimodal_delete {
+	char *name;
+};
+
+static void
+free_rpc_bimodal_delete(struct rpc_bimodal_delete *r)
+{
+	free(r->name);
+}
+
+static const struct spdk_json_object_decoder rpc_bdev_bimodal_delay_delete_decoders[] = {
+	{"name", offsetof(struct rpc_bimodal_delete, name), spdk_json_decode_string},
+};
+
+static void
+rpc_bdev_bimodal_delay_delete_cb(void *cb_arg, int bdeverrno)
+{
+	struct spdk_jsonrpc_request *request = cb_arg;
+
+	if (bdeverrno == 0) {
+		spdk_jsonrpc_send_bool_response(request, true);
+	} else {
+		spdk_jsonrpc_send_error_response(request, bdeverrno, spdk_strerror(-bdeverrno));
+	}
+}
+
+static void
+rpc_bdev_bimodal_delay_delete(struct spdk_jsonrpc_request *request,
+			      const struct spdk_json_val *params)
+{
+	struct rpc_bimodal_delete req = {};
+
+	if (spdk_json_decode_object(params, rpc_bdev_bimodal_delay_delete_decoders,
+				    SPDK_COUNTOF(rpc_bdev_bimodal_delay_delete_decoders), &req)) {
+		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INTERNAL_ERROR,
+						 "spdk_json_decode_object failed");
+		goto cleanup;
+	}
+
+	delete_bimodal_delay_disk(req.name, rpc_bdev_bimodal_delay_delete_cb, request);
+
+cleanup:
+	free_rpc_bimodal_delete(&req);
+}
+SPDK_RPC_REGISTER("bdev_bimodal_delay_delete", rpc_bdev_bimodal_delay_delete, SPDK_RPC_RUNTIME)
diff --git a/module/bdev/delay/vbdev_delay.c b/module/bdev/delay/vbdev_delay.c
