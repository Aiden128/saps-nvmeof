+static void
+bdev_nvme_hedge_free_if_done(struct nvme_bdev_hedge_ctx *ctx)
+{
+	if (!ctx->owner_completed || !ctx->primary.completed || !ctx->twin.completed) {
+		return;
+	}
+	if ((ctx->primary.abort_sent && !ctx->primary.abort_done) ||
+	    (ctx->twin.abort_sent && !ctx->twin.abort_done)) {
+		return;
+	}
+
+	free(ctx);
+}
+
+static void
+bdev_nvme_hedge_complete_owner(struct nvme_bdev_hedge_ctx *ctx,
+			       struct nvme_bdev_hedge_req *req,
+			       const struct spdk_nvme_cpl *cpl)
+{
+	struct nvme_bdev_io *bio = ctx->owner_bio;
+
+	if (ctx->owner_completed || bio == NULL) {
+		return;
+	}
+
+	ctx->owner_completed = true;
+	ctx->owner_bio = NULL;
+	bio->io_path = req->io_path;
+	bio->hedge_twin = NULL;
+	bio->hedge_io_path = NULL;
+	bdev_nvme_io_complete_nvme_status(bio, cpl);
+	bdev_nvme_hedge_free_if_done(ctx);
+}
+
+static void
+bdev_nvme_hedge_abort_done(void *ref, const struct spdk_nvme_cpl *cpl)
+{
+	struct nvme_bdev_hedge_req *req = ref;
+
+	(void)cpl;
+	req->abort_done = true;
+	bdev_nvme_hedge_free_if_done(req->ctx);
+}
+
+static void
+bdev_nvme_hedge_abort_loser(struct nvme_bdev_hedge_req *req)
+{
+	int rc;
+
+	if (!req->submitted || req->completed || req->abort_sent) {
+		return;
+	}
+
+	req->abort_sent = true;
+	req->abort_done = false;
+	rc = spdk_nvme_ctrlr_cmd_abort_ext(req->io_path->qpair->ctrlr->ctrlr,
+					   req->io_path->qpair->qpair,
+					   req, bdev_nvme_hedge_abort_done, req);
+	if (rc != 0) {
+		req->abort_sent = false;
+		req->abort_done = true;
+	}
+}
+
+static void
+bdev_nvme_hedge_read_done(void *ref, const struct spdk_nvme_cpl *cpl)
+{
+	struct nvme_bdev_hedge_req *req = ref;
+	struct nvme_bdev_hedge_ctx *ctx = req->ctx;
+	struct nvme_bdev_hedge_req *other = req == &ctx->primary ? &ctx->twin : &ctx->primary;
+
+	req->cpl = *cpl;
+	req->completed = true;
+
+	if (ctx->owner_completed) {
+		bdev_nvme_hedge_free_if_done(ctx);
+		return;
+	}
+
+	if (spdk_nvme_cpl_is_success(cpl)) {
+		bdev_nvme_hedge_abort_loser(other);
+		bdev_nvme_hedge_complete_owner(ctx, req, cpl);
+		return;
+	}
+
+	if (!ctx->first_error_valid) {
+		ctx->first_error_cpl = *cpl;
+		ctx->first_error_valid = true;
+	}
+
+	if (!other->submitted || other->completed) {
+		if (other->submitted && spdk_nvme_cpl_is_success(&other->cpl)) {
+			bdev_nvme_hedge_complete_owner(ctx, other, &other->cpl);
+		} else {
+			bdev_nvme_hedge_complete_owner(ctx, req, &ctx->first_error_cpl);
+		}
+	}
+}
