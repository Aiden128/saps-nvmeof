+static uint32_t g_host_saps_path_score[DPA_PLUGIN_CONN_MAX][DPA_PLUGIN_PATH_MAX];
+static uint32_t g_host_saps_path_score_opcode[DPA_PLUGIN_CONN_MAX][DPA_PLUGIN_PATH_MAX][DPA_PLUGIN_OPC_CLASS_MAX];
+static uint16_t g_host_saps_path_state_pub[DPA_PLUGIN_CONN_MAX][DPA_PLUGIN_PATH_MAX];
+static uint8_t  g_host_saps_path_retry_verdict[DPA_PLUGIN_CONN_MAX][DPA_PLUGIN_PATH_MAX];
