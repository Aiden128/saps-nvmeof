+static inline uint32_t
+saps_xorshift32(uint32_t *state)
+{
+	uint32_t x = *state;
+	if (spdk_unlikely(x == 0)) {
+		x = 0x9e3779b9u;
+	}
+	x ^= x << 13;
+	x ^= x >> 17;
+	x ^= x << 5;
+	*state = x;
+	return x;
+}
