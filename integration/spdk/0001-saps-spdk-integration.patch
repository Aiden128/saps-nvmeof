+/* Active flag — set by host_saps_init() if env var demands it. */
+static int g_host_saps_active;
+static int g_host_saps_trace;
+static uint64_t g_host_saps_trace_stride = 16384;
+static uint64_t g_host_saps_trace_count[DPA_PLUGIN_CONN_MAX][DPA_PLUGIN_PATH_MAX];
+
+/* Host-TSC -> ms divisor (= ticks_per_sec / 1000). */
+static uint64_t g_host_saps_ticks_per_ms = SAPS_TICKS_PER_MS_FALLBACK;
+
+/* Per-cmd_id submit_tsc map (mirrors DPA g_submit_tsc_low[65536]). cmd_id is
+ * rdma_req->id, bounded by RDMA queue depth. Tagged with qp_id+path_id index
+ * to avoid cross-qp aliasing because cmd_id alone is NOT globally unique. We
+ * keep low 32 bits of host TSC; the delta computed at complete fits in
+ * uint32_t for any latency under ~2.8 s @ 1.5 GHz.
+ *
+ * Indexing: linear table cmd_id ∈ [0, 65536). At our QD/qp+path combos the
+ * collision rate is negligible (< 256 outstanding in flight per (qp,path) at
+ * QD=32). 65536 × 4B = 256 KiB BSS. */
+static uint32_t g_host_saps_submit_tsc_low[65536];
+
+/* Ownership tag table, parallel to g_host_saps_submit_tsc_low. The slot key
+ * only folds the LOW 2 bits of qp_idx (HOST_SAPS_SUBMIT_QP_BITS) into the slot
+ * index, so qpairs whose 10-bit qp_idx differs by a multiple of 4 alias to the
+ * same slot. Widening the slot to a full 10-bit qp + 12-bit cid table of u32
+ * would be 16 MiB — too big. Instead keep the 64K-entry table and store the
+ * FULL (qp_idx, path_idx) ownership tag here; on completion a tag mismatch is
+ * treated as no-matching-submit (skip the latency sample) rather than
+ * consuming another (qp,path)'s timestamp. tag 0 is reserved as "empty". */
+static uint16_t g_host_saps_submit_tag[65536];
+
+#define HOST_SAPS_SUBMIT_CID_BITS  12u
+#define HOST_SAPS_SUBMIT_QP_BITS   2u
+#define HOST_SAPS_SUBMIT_CID_MASK  ((1u << HOST_SAPS_SUBMIT_CID_BITS) - 1u)
+#define HOST_SAPS_SUBMIT_QP_MASK   ((1u << HOST_SAPS_SUBMIT_QP_BITS) - 1u)
+
+static inline uint32_t
+host_saps_submit_slot(uint16_t cmd_id, uint16_t qp_idx, uint16_t path_idx)
+{
+	uint32_t qp_part = ((uint32_t)qp_idx & HOST_SAPS_SUBMIT_QP_MASK);
+	uint32_t path_part = ((uint32_t)path_idx & DPA_PLUGIN_PATH_MASK);
+	uint32_t owner = (qp_part << DPA_PLUGIN_PATH_LOG2) | path_part;
+
+	return (owner << HOST_SAPS_SUBMIT_CID_BITS) |
+	       ((uint32_t)cmd_id & HOST_SAPS_SUBMIT_CID_MASK);
+}
+
+/* Full ownership tag = (full 10-bit qp_idx << PATH_LOG2) | path_idx, biased by
+ * +1 so 0 means "empty slot" (a real qp=0/path=0 entry stores tag 1). */
+static inline uint16_t
+host_saps_submit_tag(uint16_t qp_idx, uint16_t path_idx)
+{
+	uint32_t qp_part = ((uint32_t)qp_idx & DPA_PLUGIN_CONN_MASK);
+	uint32_t path_part = ((uint32_t)path_idx & DPA_PLUGIN_PATH_MASK);
+	return (uint16_t)(((qp_part << DPA_PLUGIN_PATH_LOG2) | path_part) + 1u);
+}
+
+/* ─── ctrlr → path_idx atomic slot table (mirror dpa_plugin.c). ────────── */
+
+static _Atomic(const void *) g_host_saps_ctrlr_slots[DPA_PLUGIN_PATH_MAX];
+
+struct host_saps_ctrlr_cache_entry {
+	const void *ctrlr;
+	uint16_t    path_idx;
+};
+static __thread struct host_saps_ctrlr_cache_entry
+	g_host_saps_ctrlr_cache[DPA_PLUGIN_PATH_MAX];
+/* Generation of the ctrlr→slot map; bumped by host_saps_ctrlr_release() on
+ * ctrlr detach so per-thread caches invalidate (mirror dpa_plugin.c 3i fix). */
+static _Atomic uint32_t g_host_saps_ctrlr_gen;
+static __thread uint32_t g_host_saps_ctrlr_cache_gen;
+
+/* Tombstone the slot(s) owned by `ctrlr` and bump the generation so a reused
+ * ctrlr pointer cannot inherit the dead path's slot / health / score state.
+ * Called from the SPDK ctrlr-destruct hook. */
+void host_saps_ctrlr_release(const void *ctrlr)
+{
+	if (!ctrlr) {
+		return;
+	}
+	bool tombstoned = false;
+	for (uint16_t i = 0; i < DPA_PLUGIN_PATH_MAX; i++) {
+		const void *cur = atomic_load_explicit(&g_host_saps_ctrlr_slots[i],
+						       memory_order_acquire);
+		if (cur == ctrlr) {
+			const void *expected = ctrlr;
+			if (atomic_compare_exchange_strong_explicit(
+				    &g_host_saps_ctrlr_slots[i], &expected, NULL,
+				    memory_order_acq_rel, memory_order_acquire)) {
+				tombstoned = true;
+			}
+		}
+	}
+	if (tombstoned) {
+		atomic_fetch_add_explicit(&g_host_saps_ctrlr_gen, 1u,
+					  memory_order_acq_rel);
+	}
+}
+
+uint16_t host_saps_ctrlr_to_path_idx(const void *ctrlr)
+{
+	if (!ctrlr) {
+		return 0;
+	}
+	/* Flush the per-thread cache if a release bumped the generation. */
+	uint32_t gen = atomic_load_explicit(&g_host_saps_ctrlr_gen,
+					    memory_order_acquire);
+	if (__builtin_expect(g_host_saps_ctrlr_cache_gen != gen, 0)) {
+		for (uint16_t i = 0; i < DPA_PLUGIN_PATH_MAX; i++) {
+			g_host_saps_ctrlr_cache[i].ctrlr = NULL;
+		}
+		g_host_saps_ctrlr_cache_gen = gen;
+	}
+	for (uint16_t i = 0; i < DPA_PLUGIN_PATH_MAX; i++) {
+		if (__builtin_expect(g_host_saps_ctrlr_cache[i].ctrlr == ctrlr, 1)) {
+			return g_host_saps_ctrlr_cache[i].path_idx;
+		}
+	}
+	uint16_t resolved_idx = DPA_PLUGIN_PATH_MAX - 1;
+	for (uint16_t i = 0; i < DPA_PLUGIN_PATH_MAX; i++) {
+		const void *cur = atomic_load_explicit(&g_host_saps_ctrlr_slots[i],
+						       memory_order_acquire);
+		if (cur == ctrlr) {
+			resolved_idx = i;
+			goto cache_update;
+		}
+		if (cur == NULL) {
+			const void *expected = NULL;
+			if (atomic_compare_exchange_strong_explicit(
+				    &g_host_saps_ctrlr_slots[i], &expected, ctrlr,
+				    memory_order_acq_rel, memory_order_acquire)) {
+				resolved_idx = i;
+				goto cache_update;
+			}
+			if (expected == ctrlr) {
+				resolved_idx = i;
+				goto cache_update;
+			}
+		}
+	}
+cache_update:
+	for (uint16_t i = 0; i < DPA_PLUGIN_PATH_MAX; i++) {
+		if (g_host_saps_ctrlr_cache[i].ctrlr == NULL) {
+			g_host_saps_ctrlr_cache[i].ctrlr = ctrlr;
+			g_host_saps_ctrlr_cache[i].path_idx = resolved_idx;
+			return resolved_idx;
+		}
+	}
+	g_host_saps_ctrlr_cache[0].ctrlr = ctrlr;
+	g_host_saps_ctrlr_cache[0].path_idx = resolved_idx;
+	return resolved_idx;
+}
+
+/* ─── Classifier helpers (mirror dpa_plugin_dev.c). ───────────────────── */
+
+static inline uint32_t ring_count_within(const uint32_t *ring, unsigned len,
+					   uint32_t now_ms, uint32_t window_ms)
+{
+	uint32_t cnt = 0;
+	for (unsigned i = 0; i < len; i++) {
+		uint32_t t = ring[i];
+		if (t == 0) { continue; }
+		uint32_t age = now_ms - t;
+		if (age <= window_ms) { cnt++; }
+	}
+	return cnt;
+}
+
+static inline void ring_push(uint32_t *ring, uint8_t *head, unsigned len,
+			       uint32_t now_ms)
+{
+	ring[(*head) & (len - 1)] = now_ms;
+	*head = (*head + 1) & (len - 1);
+}
+
+static inline void recent_err_track(struct host_saps_path_state *p, bool is_err)
+{
+	if (p->recent_sample_count < 0xFFFF) { p->recent_sample_count++; }
+	if (is_err && p->recent_err_count < 0xFFFF) { p->recent_err_count++; }
+	if (p->recent_sample_count >= SAPS_RECENT_DECAY_PERIOD) {
+		p->recent_err_count   >>= 1;
+		p->recent_sample_count >>= 1;
+	}
+}
+
+static inline uint8_t classify_action(uint8_t sct, uint8_t sc)
+{
+	switch (sct) {
+	case 0:
+		if (sc == 0x81) { return DPA_SAPS_ACTION_TERMINAL; }
+		if (sc == 0x85) { return DPA_SAPS_ACTION_RETRY_SAME; }
+		break;
+	case 2:
+		if (sc == 0x80) { return DPA_SAPS_ACTION_TERMINAL; }
+		if (sc == 0x81) { return DPA_SAPS_ACTION_FAILOVER; }
+		if (sc == 0x86) { return DPA_SAPS_ACTION_NOT_ERROR; }
+		return DPA_SAPS_ACTION_TERMINAL;
+	case 3:
+		if (sc == 0x00) { return DPA_SAPS_ACTION_FAILOVER; }
+		if (sc == 0x04) { return DPA_SAPS_ACTION_RETRY_SAME; }
+		if (sc == 0x01) { return DPA_SAPS_ACTION_FAILOVER; }
+		return DPA_SAPS_ACTION_FAILOVER;
+	default:
+		break;
+	}
+	return DPA_SAPS_ACTION_UNSET;
+}
+
+static inline bool newma_on_sample(struct host_saps_path_state *p, int64_t log_lat)
+{
+	p->ewma_fast += ((log_lat - p->ewma_fast) * SAPS_LAMBDA_FAST_Q16) >> 16;
+	p->ewma_slow += ((log_lat - p->ewma_slow) * SAPS_LAMBDA_SLOW_Q16) >> 16;
+	if (p->n < SAPS_WARMUP_N) { return false; }
+	return abs64(p->ewma_fast - p->ewma_slow) > SAPS_H_NEWMA_Q16;
+}
+
+static inline void newma_reset(struct host_saps_path_state *p)
+{
+	p->ewma_fast = p->ewma_slow;
+}
+
+static inline uint16_t classify_fault_type_raw(const struct host_saps_path_state *p,
+						uint32_t now_ms)
+{
+	if (p->n < SAPS_WARMUP_N || p->baseline_log_lat_q16 == 0) {
+		return HOST_SAPS_FAULT_HEALTHY;
+	}
+	if (p->mean_log_lat_ewma_q16 > SAPS_LAT_ABS_SEVERE_Q16 &&
+	    p->err_rate_ewma < SAPS_ERR_RATE_LOW_Q16) {
+		return HOST_SAPS_FAULT_PERPETUAL_SLOW;
+	}
+	if (p->recent_sample_count < 4) {
+		return HOST_SAPS_FAULT_HEALTHY;
+	}
+	uint32_t newma_rate = ring_count_within(p->newma_fire_tsc_ms_ring, 8,
+						 now_ms, SAPS_FLAP_WINDOW_MS);
+	uint32_t fsm_rate   = ring_count_within(p->fsm_trans_tsc_ms_ring, 4,
+						 now_ms, SAPS_FLAP_WINDOW_MS);
+	if (newma_rate > SAPS_FLAP_NEWMA_FIRE_HI ||
+	    fsm_rate   > SAPS_FLAP_FSM_TRANS_HI) {
+		return HOST_SAPS_FAULT_FLAP;
+	}
+
+	int64_t lat_diff = p->mean_log_lat_ewma_q16 - p->baseline_log_lat_q16;
+
+	if (lat_diff > SAPS_LAT_RATIO_HI_Q16 &&
+	    p->mean_log_lat_ewma_q16 > SAPS_LAT_ABS_MODERATE_Q16 &&
+	    p->err_rate_ewma < SAPS_ERR_RATE_LOW_Q16) {
+		return HOST_SAPS_FAULT_PERPETUAL_SLOW;
+	}
+	if (p->mean_log_lat_ewma_q16 > SAPS_LAT_ABS_SLOW_Q16 &&
+	    p->err_rate_ewma < SAPS_ERR_RATE_LOW_Q16) {
+		return HOST_SAPS_FAULT_PERPETUAL_SLOW;
+	}
+	/* Slice 34 fix 2: drop lat_diff > SAPS_LAT_RATIO_OK_LO_Q16 lower bound.
+	 * Reason: sct=3 PATH ERROR fast-fails with delta_ticks≈0 → mean pulled
+	 * BELOW baseline → lat_diff large negative → original bound rejected the
+	 * sample even though recent_err_count clearly indicates NVMe errors on
+	 * this path. recent_err_count >= THRESH is sufficient evidence; latency
+	 * does not need to be elevated for SPARSE_ERROR. Upper bound retained to
+	 * keep PERPETUAL_SLOW band's claim. */
+	if (p->recent_err_count >= SAPS_RECENT_ERR_THRESH &&
+	    lat_diff < SAPS_LAT_RATIO_HI_Q16) {
+		return HOST_SAPS_FAULT_SPARSE_ERROR;
+	}
+	int64_t p99_excess = p->p99_estimate - p->mean_log_lat_ewma_q16;
+	if (p99_excess > SAPS_P99_RATIO_HI_Q16 &&
+	    p->err_rate_ewma < SAPS_ERR_RATE_LOW_Q16 &&
+	    p->recent_err_count < SAPS_RECENT_ERR_THRESH) {
+		return HOST_SAPS_FAULT_BIMODAL_TAIL;
+	}
+	return HOST_SAPS_FAULT_HEALTHY;
+}
+
+static inline uint16_t classify_fault_type(struct host_saps_path_state *p,
+					    uint32_t now_ms)
+{
+	uint16_t raw = classify_fault_type_raw(p, now_ms);
+	if (raw == HOST_SAPS_FAULT_HEALTHY) {
+		p->consec_nonhealthy_count = 0;
+		return HOST_SAPS_FAULT_HEALTHY;
+	}
+	if (raw == HOST_SAPS_FAULT_PERPETUAL_SLOW &&
+	    p->mean_log_lat_ewma_q16 > SAPS_LAT_ABS_SEVERE_Q16) {
+		p->consec_nonhealthy_count = SAPS_HYSTERESIS_N;
+		return raw;
+	}
+	if (raw == HOST_SAPS_FAULT_SPARSE_ERROR && p->recent_err_count >= 1) {
+		p->consec_nonhealthy_count = SAPS_HYSTERESIS_N;
+		return raw;
+	}
+	if (p->consec_nonhealthy_count < 0xFFu) { p->consec_nonhealthy_count++; }
+	if (p->consec_nonhealthy_count < SAPS_HYSTERESIS_N) {
+		return HOST_SAPS_FAULT_HEALTHY;
+	}
+	return raw;
+}
+
+static inline uint32_t compute_score(struct host_saps_path_state *p, uint8_t opcode)
+{
+	if (p->state == DPA_SAPS_STATE_EXCLUDED) {
+		return SAPS_SCORE_MIN;
+	}
+	if (p->state == DPA_SAPS_STATE_RECOVERING && p->probe_count == 0) {
+		return SAPS_SCORE_MIN;
+	}
+	if (p->n < SAPS_WARMUP_N) {
+		return 0;
+	}
+
+	int64_t p99 = p->p99_estimate;
+	if (p99 <= 0) { p99 = 1; }
+	int64_t base = fixed_inv_q16(p99);
+	if (base == 0) { base = 1; }
+
+	unsigned bucket = opc_bucket(opcode);
+	int64_t opc_p99 = p->opc_p99[bucket].p99;
+	int64_t opc_boost_q16 = (int64_t)1 << 16;
+	if (p->opc_p99[bucket].n > SAPS_WARMUP_N && opc_p99 > 0) {
+		opc_boost_q16 = fixed_inv_q16(opc_p99);
+		if (opc_boost_q16 == 0) {
+			opc_boost_q16 = (int64_t)1 << 16;
+		}
+	}
+
+	int64_t combined = (base * opc_boost_q16) >> 16;
+	int64_t boosted  = (combined * (int64_t)SAPS_SCORE_SCALE) >> 16;
+
+	int64_t err_pen = (p->err_rate_ewma * (int64_t)SAPS_W_ERR) >> 16;
+
+	int64_t qd_pen      = (int64_t)p->inflight * SAPS_W_QD_NEW;
+	int64_t latency_bonus = boosted >> 4;
+	int64_t total = (int64_t)SAPS_QD_SCORE_BASE - qd_pen + latency_bonus - err_pen;
+
+	if (p->fault_type == HOST_SAPS_FAULT_HEALTHY) {
+		/* Slice 9.7 v2: drop both latency_bonus AND qd_pen for HEALTHY paths. */
+		total = (int64_t)SAPS_QD_SCORE_BASE - err_pen;
+	}
+
+	if (total < (int64_t)SAPS_SCORE_MIN) { total = SAPS_SCORE_MIN; }
+	if (total > (int64_t)SAPS_SCORE_MAX) { total = SAPS_SCORE_MAX; }
+
+	switch (p->fault_type) {
+	case HOST_SAPS_FAULT_PERPETUAL_SLOW:
+		total = SAPS_SCORE_MIN;
+		break;
+	case HOST_SAPS_FAULT_SPARSE_ERROR:
+		total = SAPS_SCORE_MIN;
+		break;
+	case HOST_SAPS_FAULT_BIMODAL_TAIL:
+		total = SAPS_SCORE_MIN;
+		break;
+	default:
+		break;
+	}
+	return (uint32_t)total;
+}
+
+static inline uint32_t compute_score_opcode(struct host_saps_path_state *p,
+					    unsigned opc_bucket_idx)
+{
+	if (opc_bucket_idx >= DPA_PLUGIN_OPC_CLASS_MAX) {
+		return 0;
+	}
+	if (p->state == DPA_SAPS_STATE_EXCLUDED) {
+		return SAPS_SCORE_MIN;
+	}
+	if (p->state == DPA_SAPS_STATE_RECOVERING && p->probe_count == 0) {
+		return SAPS_SCORE_MIN;
+	}
+	if (p->n < SAPS_WARMUP_N) {
+		return 0;
+	}
+
+	int64_t opc_p99 = p->opc_p99[opc_bucket_idx].p99;
+	if (p->opc_p99[opc_bucket_idx].n <= SAPS_WARMUP_N || opc_p99 <= 0) {
+		return 0;
+	}
+
+	int64_t opc_boost_q16 = fixed_inv_q16(opc_p99);
+	if (opc_boost_q16 == 0) {
+		opc_boost_q16 = (int64_t)1 << 16;
+	}
+
+	int64_t p99 = p->p99_estimate;
+	if (p99 <= 0) {
+		p99 = 1;
+	}
+
+	int64_t base_overall = fixed_inv_q16(p99);
+	int64_t ratio_q16;
+	if (base_overall > 0) {
+		ratio_q16 = (opc_boost_q16 << 16) / base_overall;
+	} else {
+		ratio_q16 = (int64_t)1 << 16;
+	}
+	if (ratio_q16 > ((int64_t)1 << 16)) {
+		ratio_q16 = (int64_t)1 << 16;
+	}
+	if (ratio_q16 < 0) {
+		ratio_q16 = 0;
+	}
+
+	int64_t err_pen = (p->err_rate_ewma * (int64_t)SAPS_W_ERR) >> 16;
+	int64_t total = (((int64_t)SAPS_QD_SCORE_BASE * ratio_q16) >> 16) - err_pen;
+
+	if (total < (int64_t)SAPS_SCORE_MIN) {
+		total = SAPS_SCORE_MIN;
+	}
+	if (total > (int64_t)SAPS_SCORE_MAX) {
+		total = SAPS_SCORE_MAX;
+	}
+
+	switch (p->fault_type) {
+	case HOST_SAPS_FAULT_PERPETUAL_SLOW:
+	case HOST_SAPS_FAULT_SPARSE_ERROR:
+	case HOST_SAPS_FAULT_BIMODAL_TAIL:
+		total = SAPS_SCORE_MIN;
+		break;
+	default:
+		break;
+	}
+	return (uint32_t)total;
+}
+
+static inline void update_state_machine(struct host_saps_path_state *p,
+					 bool detector_changed,
+					 uint64_t now_tsc)
+{
+	/* Slice 28 port: FSM transitions are now driven by p->fault_type, not the
+	 * raw NEWMA detector_changed flag (kept for signature/ABI parity). */
+	(void)detector_changed;
+
+	if (p->fault_type == HOST_SAPS_FAULT_FLAP &&
+	    p->flap_dampening_until_tsc != 0 &&
+	    now_tsc < p->flap_dampening_until_tsc) {
+		return;
+	}
+
+	uint16_t new_state = p->state;
+	uint64_t since = (now_tsc >= p->state_entered_tsc)
+			 ? (now_tsc - p->state_entered_tsc)
+			 : 0;
+
+	uint64_t T_DEG_TICKS     = 500ull  * g_host_saps_ticks_per_ms;
+	uint64_t T_RECOVER_TICKS = 100ull  * g_host_saps_ticks_per_ms;
+	uint64_t T_EXCLUDE_TICKS = 1000ull * g_host_saps_ticks_per_ms;
+
+	switch (p->state) {
+	case DPA_SAPS_STATE_HEALTHY:
+		/* Mirror dpa_plugin_dev.c Slice 28: drive FSM transitions via
+		 * fault_type (hysteresis-filtered classifier output) rather than raw
+		 * NEWMA detector_changed. Raw NEWMA is a change-point detector: on a
+		 * persistent step (D1 5ms B) it fires ONCE at onset then re-converges
+		 * and stops firing. With the old detector_changed gate the path moved
+		 * HEALTHY→DEGRADING at onset but DEGRADING→EXCLUDED never fired again,
+		 * so B stuck in DEGRADING forever and leaked ~13.5% of IO. Using
+		 * fault_type (PERPETUAL_SLOW asserted on every slow sample) lets the
+		 * persistent fault escalate DEGRADING→EXCLUDED, matching the DPA path
+		 * so the host-vs-DPA comparison isolates placement, not this bug.
+		 * FLAP is excluded from escalation: a flapping path recovers, it is
+		 * not a dead path (and is already frozen by the dampening guard above). */
+		if ((p->fault_type != HOST_SAPS_FAULT_HEALTHY &&
+		     p->fault_type != HOST_SAPS_FAULT_FLAP) ||
+		    p->err_rate_ewma > SAPS_E_HI_Q16) {
+			new_state = DPA_SAPS_STATE_DEGRADING;
+		}
+		break;
+	case DPA_SAPS_STATE_DEGRADING:
+		if (p->fault_type != HOST_SAPS_FAULT_HEALTHY &&
+		    p->fault_type != HOST_SAPS_FAULT_FLAP &&
+		    since > T_DEG_TICKS) {
+			new_state = DPA_SAPS_STATE_EXCLUDED;
+		} else if (p->fault_type == HOST_SAPS_FAULT_HEALTHY &&
+			   p->err_rate_ewma < SAPS_E_LO_Q16 &&
+			   since > T_RECOVER_TICKS) {
+			new_state = DPA_SAPS_STATE_HEALTHY;
+		}
+		break;
+	case DPA_SAPS_STATE_EXCLUDED:
+		if (since > T_EXCLUDE_TICKS) {
+			new_state = DPA_SAPS_STATE_RECOVERING;
+			p->probe_count = 0;
+			/* Mirror dpa_plugin_dev.c Slice 32/33: reset the hysteresis
+			 * counter and the mean/NEWMA EWMA state to the frozen baseline
+			 * on RECOVERING entry. A genuinely still-slow path (D1 5ms B)
+			 * re-saturates the hysteresis in the first slow probe and returns
+			 * EXCLUDED; a recovered path sees raw=HEALTHY and accumulates
+			 * probe_count to N_PROBE → HEALTHY. Without the reset the stale
+			 * high mean / NEWMA drift would bounce RECOVERING↔EXCLUDED. */
+			p->consec_nonhealthy_count = 0;
+			if (p->baseline_log_lat_q16 != 0) {
+				p->mean_log_lat_ewma_q16 = p->baseline_log_lat_q16;
+			}
+			p->ewma_fast = p->ewma_slow;
+		}
+		break;
+	case DPA_SAPS_STATE_RECOVERING:
+		/* Mirror dpa_plugin_dev.c Slice 28: re-exclude on persistent
+		 * fault_type, not raw NEWMA. For D1 5ms B the absolute-latency rule
+		 * asserts PERPETUAL_SLOW on the first slow probe (mean still elevated
+		 * from the fault), so the path returns to EXCLUDED rather than
+		 * spuriously recovering to HEALTHY when detector_changed stays false
+		 * on a persistent step. */
+		if ((p->fault_type != HOST_SAPS_FAULT_HEALTHY &&
+		     p->fault_type != HOST_SAPS_FAULT_FLAP) ||
+		    p->err_rate_ewma > SAPS_E_HI_Q16) {
+			new_state = DPA_SAPS_STATE_EXCLUDED;
+		} else {
+			p->probe_count++;
+			if (p->probe_count >= SAPS_N_PROBE) {
+				new_state = DPA_SAPS_STATE_HEALTHY;
+			}
+		}
+		break;
+	default:
+		new_state = DPA_SAPS_STATE_HEALTHY;
+		break;
+	}
+
+	if (new_state != p->state) {
+		p->state = new_state;
+		p->state_entered_tsc = now_tsc;
+		uint32_t now_ms = (uint32_t)(now_tsc / g_host_saps_ticks_per_ms);
+		ring_push(p->fsm_trans_tsc_ms_ring,
+			   &p->fsm_trans_ring_head, 4, now_ms);
+		if (new_state == DPA_SAPS_STATE_HEALTHY ||
+		    new_state == DPA_SAPS_STATE_DEGRADING) {
+			newma_reset(p);
+		}
+	}
+}
+
+static inline void saps_update_complete(uint16_t qp_idx, uint16_t path_idx,
+					 uint8_t opcode, uint16_t sct_sc,
+					 uint8_t retry_count, uint64_t host_tsc,
+					 uint32_t delta_ticks, bool have_lat_sample)
+{
+	struct host_saps_path_state *p = &g_host_saps_path[qp_idx][path_idx];
+
+	if (p->inflight > 0) { p->inflight--; }
+
+	p->last_complete_tsc = host_tsc;
+
+	bool detector_changed = false;
+	int64_t log_lat = fixed_log2((uint64_t)delta_ticks);
+
+	/* Slice 34 (root cause for D3 sct=3 mis-drain): filter sct≠0 fast-fail
+	 * completions out of latency statistics. NVMe sct=3 PATH ERROR completes
+	 * with delta_ticks≈0 (target rejects fast). Feeding those into mean_log_lat
+	 * EWMA pulls path B's mean BELOW baseline → lat_diff = mean - baseline goes
+	 * large NEGATIVE → SPARSE_ERROR Rule 3 lower-bound (lat_diff > -log2(1.25))
+	 * fails → fault never classified on B → FAILOVER overlay retries B's errors
+	 * to A/C → A/C's lat_diff occasionally exceeds threshold → wrong-path drain.
+	 * Fix: only feed clean sct=0 completions into latency stats; the err_rate
+	 * EWMA / recent_err_count below already captures error signal independently.
+	 *
+	 * have_lat_sample gates out completions with no matching submit timestamp
+	 * (empty slot or aliased tag mismatch) so a fabricated delta_ticks=1 can
+	 * never bias mean_log_lat / baseline down. */
+	if (have_lat_sample && retry_count == 0 && (sct_sc >> 8) == 0) {
+		p->n++;
+		if (p->n == 1) {
+			p->ewma_fast = log_lat;
+			p->ewma_slow = log_lat;
+			p->mean_log_lat_ewma_q16 = log_lat;
+		}
+
+		int64_t mean_delta = log_lat - p->mean_log_lat_ewma_q16;
+		p->mean_log_lat_ewma_q16 +=
+			(mean_delta * SAPS_MEAN_LAT_EWMA_ALPHA) >> 16;
+
+		int64_t mean_delta_post = log_lat - p->mean_log_lat_ewma_q16;
+		int64_t welford_term    = (mean_delta * mean_delta_post) >> 16;
+		if (welford_term < 0) { welford_term = 0; }
+		int64_t var_delta = welford_term - p->lat_var_ewma_q16;
+		p->lat_var_ewma_q16 +=
+			(var_delta * SAPS_LAT_VAR_EWMA_ALPHA) >> 16;
+		if (p->lat_var_ewma_q16 < 0) { p->lat_var_ewma_q16 = 0; }
+
+		if (p->n == SAPS_WARMUP_N && p->baseline_log_lat_q16 == 0) {
+			p->baseline_log_lat_q16 = p->mean_log_lat_ewma_q16;
+			if (p->baseline_log_lat_q16 == 0) {
+				p->baseline_log_lat_q16 = 1;
+			}
+		}
+
+		detector_changed = newma_on_sample(p, log_lat);
+		if (detector_changed) {
+			uint32_t now_ms_fire =
+				(uint32_t)(host_tsc / g_host_saps_ticks_per_ms);
+			ring_push(p->newma_fire_tsc_ms_ring,
+				   &p->newma_fire_ring_head, 8, now_ms_fire);
+		}
+
+		uint64_t seed = host_tsc ^ (p->n * 0x9E3779B97F4A7C15ull);
+		frugal2u_update(&p->p99_estimate, &p->frugal_step, log_lat, seed);
+
+		unsigned bucket = opc_bucket(opcode);
+		p->opc_p99[bucket].n++;
+		if (p->opc_p99[bucket].p99 <= 0) {
+			p->opc_p99[bucket].p99 = log_lat;
+		} else {
+			p->opc_p99[bucket].p99 +=
+				(log_lat - p->opc_p99[bucket].p99) >> 4;
+		}
+	}
+
+	uint8_t verdict = DPA_SAPS_ACTION_UNSET;
+	if (sct_sc != 0) {
+		uint8_t sct = (uint8_t)((sct_sc >> 8) & 0xFF);
+		uint8_t sc  = (uint8_t)(sct_sc & 0xFF);
+		if (sct < 4) { p->err_hist[sct][sc & 0xF]++; }
+		p->err_rate_ewma = ((int64_t)SAPS_ERR_ALPHA_Q16 * ((int64_t)1 << 16)
+				    + ((int64_t)(1 << 16) - SAPS_ERR_ALPHA_Q16)
+					   * p->err_rate_ewma)
+				   >> 16;
+		verdict = classify_action(sct, sc);
+		recent_err_track(p, true);
+	} else {
+		p->err_rate_ewma = (((int64_t)(1 << 16) - SAPS_ERR_ALPHA_Q16)
+					   * p->err_rate_ewma) >> 16;
+		recent_err_track(p, false);
+	}
+
+	uint32_t now_ms = (uint32_t)(host_tsc / g_host_saps_ticks_per_ms);
+	uint16_t prev_fault = p->fault_type;
+	uint16_t prev_state = p->state;
+	uint16_t new_fault  = classify_fault_type(p, now_ms);
+	p->fault_type = new_fault;
+
+	if (new_fault == HOST_SAPS_FAULT_FLAP) {
+		if (prev_fault != HOST_SAPS_FAULT_FLAP) {
+			p->flap_dampening_window_ms = SAPS_FLAP_DAMP_MS_INIT;
+			p->flap_dampening_until_tsc =
+				host_tsc + (uint64_t)SAPS_FLAP_DAMP_MS_INIT
+					   * g_host_saps_ticks_per_ms;
+		} else if (host_tsc >= p->flap_dampening_until_tsc) {
+			uint32_t w = p->flap_dampening_window_ms * 2;
+			if (w > SAPS_FLAP_DAMP_MS_MAX) { w = SAPS_FLAP_DAMP_MS_MAX; }
+			p->flap_dampening_window_ms = w;
+			p->flap_dampening_until_tsc =
+				host_tsc + (uint64_t)w * g_host_saps_ticks_per_ms;
+		}
+	} else {
+		p->flap_dampening_until_tsc = 0;
+		p->flap_dampening_window_ms = 0;
+	}
+
+	update_state_machine(p, detector_changed, host_tsc);
+
+	uint32_t score = compute_score(p, opcode);
+	p->score = score;
+
+	if (score != 0) {
+		g_host_saps_path_score[qp_idx][path_idx] = score;
+	}
+	for (unsigned opc = 0; opc < DPA_PLUGIN_OPC_CLASS_MAX; opc++) {
+		uint32_t opc_score = compute_score_opcode(p, opc);
+		if (opc_score != 0) {
+			g_host_saps_path_score_opcode[qp_idx][path_idx][opc] = opc_score;
+		}
+	}
+	g_host_saps_path_state_pub[qp_idx][path_idx] = p->state;
+	if (g_host_saps_trace && path_idx == 1) {
+		uint64_t cnt = __atomic_add_fetch(
+			&g_host_saps_trace_count[qp_idx][path_idx], 1,
+			__ATOMIC_RELAXED);
+		bool changed = (prev_fault != p->fault_type) || (prev_state != p->state);
+		uint64_t stride = g_host_saps_trace_stride ? g_host_saps_trace_stride : 1;
+		if (changed || (cnt % stride) == 0) {
+			uint64_t lat_us = g_host_saps_ticks_per_ms ?
+				((uint64_t)delta_ticks * 1000ull) / g_host_saps_ticks_per_ms : 0;
+			fprintf(stderr,
+				"SAPS_TRACE host_saps now_ms=%u qp=%u path=%u n=%lu cnt=%lu "
+				"fault_type=%u prev_fault_type=%u state_pub=%u prev_state=%u "
+				"mean_log_lat_ewma_q16=%ld baseline_log_lat_q16=%ld "
+				"delta_ticks=%u lat_us=%lu score=%u inflight=%u detector_changed=%u\n",
+				now_ms, qp_idx, path_idx, (unsigned long)p->n,
+				(unsigned long)cnt, p->fault_type, prev_fault, p->state,
+				prev_state, (long)p->mean_log_lat_ewma_q16,
+				(long)p->baseline_log_lat_q16, delta_ticks,
+				(unsigned long)lat_us, score, p->inflight,
+				detector_changed ? 1u : 0u);
+		}
+	}
+	if (verdict != DPA_SAPS_ACTION_UNSET) {
+		g_host_saps_path_retry_verdict[qp_idx][path_idx] = verdict;
+	} else {
+		g_host_saps_path_retry_verdict[qp_idx][path_idx] = DPA_SAPS_ACTION_UNSET;
+	}
+}
+
+static inline void saps_update_submit(uint16_t qp_idx, uint16_t path_idx,
+				       uint8_t opcode)
+{
+	struct host_saps_path_state *p = &g_host_saps_path[qp_idx][path_idx];
+	p->inflight++;
+	int64_t qd_sample = (int64_t)p->inflight << 16;
+	int64_t qd_delta = qd_sample - p->qd_mean;
+	p->qd_mean += qd_delta >> 5;
+	p->qd_m2  += (qd_delta * qd_delta) >> 32;
+
+	if (p->n >= SAPS_WARMUP_N) {
+		uint32_t new_score = compute_score(p, opcode);
+		if (new_score != 0) {
+			p->score = new_score;
+			g_host_saps_path_score[qp_idx][path_idx] = new_score;
+		}
+		for (unsigned opc = 0; opc < DPA_PLUGIN_OPC_CLASS_MAX; opc++) {
+			uint32_t opc_score = compute_score_opcode(p, opc);
+			if (opc_score != 0) {
+				g_host_saps_path_score_opcode[qp_idx][path_idx][opc] = opc_score;
+			}
+		}
+	}
+}
+
+/* ═══════════════════════════════════════════════════════════════════════════
+ *  SAPS QoS CONTROL PLANE — host-resident port of the DPA control plane.
+ *
+ *  Ports the SAPS-Q control plane from dpa_plugin_dev.c so the host-only SAPS
+ *  variant runs the COMPLETE unified SAPS (signal plane above + control plane
+ *  here) on the host SPDK reactor core. This is the part that measures the host
+ *  CPU cost of the control plane when it is NOT offloaded to the DPA.
+ *
+ *  Faithful ports (function-by-function, same Q-arithmetic):
+ *    m3_refresh_credit / m3_consume      (dpa_plugin_dev.c:1519 / :1558)
+ *    m4_refresh_and_consume              (dpa_plugin_dev.c:1584)
+ *    sapsq_allocate (weighted max-min)   (dpa_plugin_dev.c:4966) — DOMINANT cost
+ *    sapsq_compute_health                (dpa_plugin_dev.c:4695)
+ *    sapsq_run_epoch                     (dpa_plugin_dev.c:5126)
+ *    m5_drr_round                        (dpa_plugin_dev.c:5707)
+ *
+ *  Differences from the DPA version (all justified):
+ *    * No shared mmap / no PCIe writeback fences (__dpa_thread_window_writeback,
+ *      __atomic_signal_fence) — host classifier + control plane + readers all
+ *      live in the SAME process on the SAME reactor, so the epoch publication
+ *      protocol collapses to a plain store (no cross-device coherence needed).
+ *    * The DPA epoch is event-driven from its own polling loop via TSC; on the
+ *      host we drive the epoch from inside host_saps_on_io_complete (the per-IO
+ *      reactor hook) by checking elapsed TSC since the last epoch. This keeps
+ *      the heavy sapsq_allocate work ON the reactor core — exactly what we are
+ *      measuring.
+ *    * Tenant/path dimensions generalised to HOST_SAPS_TENANT_MAX=256 /
+ *      HOST_SAPS_QPATH_MAX=8 (DPA used SAPSQ_TENANT_MAX=16 × SAPSQ_PATH_MAX=4).
+ *      Same code, larger fixed arrays, runtime count from env (default mirrors
+ *      the DPA E2 config: 4 tenants, 3 paths, weights 3:1:1:1, link 200K IOPS).
+ *
+ *  Activation: gated behind g_host_saps_active (HOST_SAPS_ENABLED=1). When
+ *  host_saps is inactive the whole block is dead — zero overhead, behaviour
+ *  unchanged. Config read from HOST_SAPS_* env vars (own namespace so the
+ *  DO-NOT-EDIT run scripts that only set HOST_SAPS_ENABLED=1 still exercise the
+ *  control plane via the built-in defaults).
+ * ═══════════════════════════════════════════════════════════════════════════ */
+
+/* Generalised dimensions (task req #4: support >= 256 tenants). */
+#define HOST_SAPS_TENANT_MAX  256u
+#define HOST_SAPS_QPATH_MAX   8u     /* matches DPA SAPSQ_MAX_PATHS */
+
+#define HOST_SAPS_Q16_ONE     ((uint32_t)(1u << 16))
+/* Δtsc clamp — mirror M3_DELTA_TSC_CAP semantics (idle-gap overflow guard). */
+#define HOST_SAPS_DELTA_TSC_CAP  ((uint64_t)100000000ULL)
+
+/* Eligibility enum — mirror SAPSQ_ELIG_* (dpa_plugin_com.h). */
+#define HOST_SAPS_ELIG_QUARANTINE  0u
+#define HOST_SAPS_ELIG_PROBE       1u
+#define HOST_SAPS_ELIG_NORMAL      2u
+
+/* Health factors in Q16.16 — mirror SAPSQ_HEALTH_* (dpa_plugin_com.h). */
+#define HOST_SAPS_HEALTH_HEALTHY_Q16  ((uint32_t)(1u << 16))  /* 1.0 */
+#define HOST_SAPS_HEALTH_PROBE_Q16    ((uint32_t)100u)        /* ε   */
+#define HOST_SAPS_HEALTH_QUARANTINE   ((uint32_t)0u)
+
+/* RECOVERING hysteretic ramp — mirror SAPSQ_RECOVER_* (dpa_plugin_dev.c). */
+#define HOST_SAPS_RECOVER_STEP_Q16    (8192u)   /* +0.125 per epoch */
+#define HOST_SAPS_RECOVER_FLOOR_Q16   (32768u)  /* start at 0.5     */
+
+/* Host control-plane state (mirrors the SAPS-Q fields of struct
+ * dpa_plugin_shared, generalised to HOST_SAPS_TENANT_MAX × HOST_SAPS_QPATH_MAX).
+ * Single-process / single-reactor, so plain (non-volatile, non-atomic) storage.
+ */
+struct host_sapsq_cp {
+	/* Config (host init writes once). */
+	uint32_t enabled;
+	uint32_t num_tenants;                              /* runtime, <= MAX */
+	uint32_t num_paths;                                /* runtime, <= MAX */
+	uint32_t my_tenant_id;
+	uint64_t link_cap_iops;
+	uint32_t epoch_period_us;
+	uint64_t tsc_freq;                                 /* host TSC Hz */
+	uint64_t epoch_period_tsc;                         /* derived */
+	uint32_t probe_rate_q32;                           /* Q0.32 IO/tsc */
+
+	/* Per-tenant config / demand. */
+	uint32_t tenant_weight[HOST_SAPS_TENANT_MAX];      /* integer weights */
+	uint32_t tenant_weight_q16[HOST_SAPS_TENANT_MAX];  /* Q16.16 (sapsq_allocate) */
+	uint32_t demand_ewma_q32[HOST_SAPS_TENANT_MAX];    /* IO/s EWMA */
+	uint32_t zero_epochs[HOST_SAPS_TENANT_MAX];        /* consec idle epochs */
+	uint64_t submit_count[HOST_SAPS_TENANT_MAX];       /* per-tenant submit ctr */
+	uint64_t submit_last[HOST_SAPS_TENANT_MAX];        /* snapshot prev epoch */
+
+	/* Per-path config + DPA-computed state. */
+	uint32_t path_base_iops_q32[HOST_SAPS_QPATH_MAX];  /* Q0.32 IO/tsc */
+	uint32_t path_health_q16[HOST_SAPS_QPATH_MAX];     /* Q16.16 */
+	uint32_t path_health_factor_q16[HOST_SAPS_QPATH_MAX];
+	uint8_t  path_eligibility[HOST_SAPS_QPATH_MAX];
+	uint8_t  path_health_enum[HOST_SAPS_QPATH_MAX];
+	uint32_t recover_ramp_q16[HOST_SAPS_QPATH_MAX];
+
+	/* Allocator output: per-(tenant,path) rate in Q0.32 IO/tsc. */
+	uint32_t tenant_path_rate_q32[HOST_SAPS_TENANT_MAX][HOST_SAPS_QPATH_MAX];
+
+	/* Host-side token bucket state (per (tenant,path)). */
+	uint32_t tenant_path_tokens_q16[HOST_SAPS_TENANT_MAX][HOST_SAPS_QPATH_MAX];
+	uint64_t tenant_path_refresh_tsc[HOST_SAPS_TENANT_MAX][HOST_SAPS_QPATH_MAX];
+
+	/* M3 credit ledger (Q32.32 credits). */
+	int64_t  m3_credits_q32[HOST_SAPS_TENANT_MAX];
+	uint64_t m3_last_tsc[HOST_SAPS_TENANT_MAX];
+	int64_t  m3_capacity_per_tsc_q32;
+	int64_t  m3_credit_per_io_q32;
+
+	/* M4 token bucket (Q16.16 tokens). */
+	uint32_t m4_tokens_q16[HOST_SAPS_TENANT_MAX];
+	uint32_t m4_refresh_per_tsc_q32[HOST_SAPS_TENANT_MAX];
+	uint32_t m4_burst_cap_q16[HOST_SAPS_TENANT_MAX];
+	uint32_t m4_reject_flag[HOST_SAPS_TENANT_MAX];
+	uint64_t m4_last_refresh_tsc[HOST_SAPS_TENANT_MAX];
+
+	/* M5 DRR scheduler state. */
+	uint64_t m5_grant_count[HOST_SAPS_TENANT_MAX];
+	uint64_t m5_consumed_count[HOST_SAPS_TENANT_MAX];
+	int32_t  m5_deficit_q16[HOST_SAPS_TENANT_MAX];
+	uint32_t m5_rate_q32[HOST_SAPS_TENANT_MAX];        /* Q0.32 IO/tsc */
+	uint32_t m5_burst_mult;
+	uint64_t m5_last_tsc;
+	uint64_t m5_interval_tsc;
+
+	/* Epoch bookkeeping. */
+	uint64_t epoch;
+	uint64_t last_epoch_tsc;
+
+	/* Gate toggles. */
+	uint32_t m3_enabled;
+	uint32_t m4_enabled;
+	uint32_t m5_enabled;
+	uint32_t bypass_d_classifier;
+
+	/* Observability (task req #3 — prove the control plane ran on host). */
+	uint64_t epoch_run_count;          /* number of sapsq_allocate epochs */
+	uint64_t m4_admit_count;
+	uint64_t m4_reject_count;
+	uint64_t last_cap_eff_q32[HOST_SAPS_QPATH_MAX];
+	uint64_t last_total_cap_q32;
+};
+
+static struct host_sapsq_cp g_host_sapsq;
+
+/* ── M3 credit ledger (port of m3_refresh_credit / m3_consume) ───────────── */
+
+static inline void host_m3_refresh_credit(struct host_sapsq_cp *cp,
+					   uint32_t tenant_id, uint64_t now_tsc)
+{
+	uint64_t last = cp->m3_last_tsc[tenant_id];
+	if (last == 0) {
+		cp->m3_last_tsc[tenant_id] = now_tsc;
+		return;
+	}
+	uint64_t delta_tsc = now_tsc - last;
+	if (delta_tsc == 0) {
+		return;
+	}
+	if (delta_tsc > HOST_SAPS_DELTA_TSC_CAP) {
+		delta_tsc = HOST_SAPS_DELTA_TSC_CAP;
+	}
+
+	uint32_t w_q16 = cp->tenant_weight_q16[tenant_id];
+	int64_t cap_per_tsc_q32 = cp->m3_capacity_per_tsc_q32;
+	if (w_q16 == 0 || cap_per_tsc_q32 == 0) {
+		cp->m3_last_tsc[tenant_id] = now_tsc;
+		return;
+	}
+
+	int64_t refill_q32 = ((int64_t)w_q16 * cap_per_tsc_q32) >> 16;
+	refill_q32 = refill_q32 * (int64_t)delta_tsc;
+	int64_t credits = cp->m3_credits_q32[tenant_id] + refill_q32;
+	int64_t burst_cap_q32 = (int64_t)1000LL << 32;   /* M3_BURST_CAP_Q32 */
+	if (credits > burst_cap_q32) {
+		credits = burst_cap_q32;
+	}
+	cp->m3_credits_q32[tenant_id] = credits;
+	cp->m3_last_tsc[tenant_id] = now_tsc;
+}
+
+static inline bool host_m3_consume(struct host_sapsq_cp *cp, uint32_t tenant_id)
+{
+	int64_t c = cp->m3_credits_q32[tenant_id];
+	int64_t cost = cp->m3_credit_per_io_q32;
+	if (cost == 0) {
+		cost = (int64_t)1 << 32;   /* default 1.0 in Q32.32 */
+	}
+	if (c >= cost) {
+		cp->m3_credits_q32[tenant_id] = c - cost;
+		return true;
+	}
+	return false;
+}
+
+/* ── M4 admission control token bucket (port of m4_refresh_and_consume) ──── */
+
+static inline void host_m4_refresh_and_consume(struct host_sapsq_cp *cp,
+						uint32_t tenant_id, uint64_t now_tsc)
+{
+	uint64_t last = cp->m4_last_refresh_tsc[tenant_id];
+	if (last == 0) {
+		cp->m4_last_refresh_tsc[tenant_id] = now_tsc;
+	} else {
+		uint64_t delta_tsc = now_tsc - last;
+		if (delta_tsc > HOST_SAPS_DELTA_TSC_CAP) {
+			delta_tsc = HOST_SAPS_DELTA_TSC_CAP;
+		}
+		if (delta_tsc > 0) {
+			uint32_t rate_q32 = cp->m4_refresh_per_tsc_q32[tenant_id];
+			uint32_t cap_q16  = cp->m4_burst_cap_q16[tenant_id];
+			uint64_t tokens   = cp->m4_tokens_q16[tenant_id];
+			uint64_t refill_q16 = ((uint64_t)rate_q32 * delta_tsc) >> 16;
+			tokens += refill_q16;
+			if (cap_q16 != 0 && tokens > cap_q16) {
+				tokens = cap_q16;
+			}
+			cp->m4_tokens_q16[tenant_id] = (uint32_t)tokens;
+			cp->m4_last_refresh_tsc[tenant_id] = now_tsc;
+		}
+	}
+
+	uint32_t tokens_now = cp->m4_tokens_q16[tenant_id];
+	if (tokens_now >= HOST_SAPS_Q16_ONE) {
+		cp->m4_tokens_q16[tenant_id] = tokens_now - HOST_SAPS_Q16_ONE;
+		cp->m4_reject_flag[tenant_id] = 0;
+		cp->m4_admit_count++;
+	} else {
+		cp->m4_reject_flag[tenant_id] = 1;
+		cp->m4_reject_count++;
+	}
+}
+
+/* ── Per-path health from aggregated FSM state (port of sapsq_compute_health) ─
+ *
+ * The DPA aggregates the per-(qp,path) classifier FSM state/fault across all
+ * QP rows and maps the worst to a health_factor + eligibility. Host port reads
+ * the same per-path published state/fault tables (g_host_saps_path_state_pub /
+ * g_host_saps_path[].fault_type) and applies the identical mapping. Path index
+ * is logical [0, num_paths); host stores PATH_MAX=4 physical slots, so paths
+ * beyond DPA_PLUGIN_PATH_MAX (4) inherit HEALTHY. */
+static inline uint8_t host_sapsq_state_rank(uint16_t st)
+{
+	switch (st) {
+	case DPA_SAPS_STATE_EXCLUDED:   return 3;
+	case DPA_SAPS_STATE_DEGRADING:  return 2;
+	case DPA_SAPS_STATE_RECOVERING: return 1;
+	case DPA_SAPS_STATE_HEALTHY:
+	default:                        return 0;
+	}
+}
+
+static inline void host_sapsq_compute_health(struct host_sapsq_cp *cp)
+{
+	if (cp->bypass_d_classifier) {
+		for (uint32_t p = 0; p < HOST_SAPS_QPATH_MAX; p++) {
+			cp->path_health_q16[p]        = HOST_SAPS_HEALTH_HEALTHY_Q16;
+			cp->path_eligibility[p]       = HOST_SAPS_ELIG_NORMAL;
+			cp->path_health_enum[p]       = 0;
+			cp->path_health_factor_q16[p] = HOST_SAPS_HEALTH_HEALTHY_Q16;
+			cp->recover_ramp_q16[p]       = 0;
+		}
+		return;
+	}
+
+	uint16_t worst_state[HOST_SAPS_QPATH_MAX];
+	uint16_t worst_fault[HOST_SAPS_QPATH_MAX];
+	uint8_t  any_active[HOST_SAPS_QPATH_MAX];
+	/* worst (max) recent_err_count per path across all QP rows — used by the
+	 * BIMODAL_TAIL penalty below, which previously read only row 0 even
+	 * though the aggregation walks every active row. */
+	uint16_t worst_err_count[HOST_SAPS_QPATH_MAX];
+	for (uint32_t p = 0; p < HOST_SAPS_QPATH_MAX; p++) {
+		worst_state[p] = DPA_SAPS_STATE_HEALTHY;
+		worst_fault[p] = HOST_SAPS_FAULT_HEALTHY;
+		any_active[p]  = 0;
+		worst_err_count[p] = 0;
+	}
+
+	/* Aggregate worst FSM state/fault across all QP rows (mirror DPA loop).
+	 * Only the PATH_MAX physical slots carry classifier state. */
+	for (uint32_t qp = 0; qp < DPA_PLUGIN_CONN_MAX; qp++) {
+		bool active = false;
+		for (uint32_t p = 0; p < DPA_PLUGIN_PATH_MAX; p++) {
+			if (g_host_saps_path[qp][p].n != 0) {
+				active = true;
+				break;
+			}
+		}
+		if (!active) {
+			continue;
+		}
+		for (uint32_t p = 0; p < DPA_PLUGIN_PATH_MAX; p++) {
+			if (g_host_saps_path[qp][p].n == 0) {
+				continue;
+			}
+			uint16_t st = g_host_saps_path_state_pub[qp][p];
+			uint16_t ft = g_host_saps_path[qp][p].fault_type;
+			uint16_t ec = g_host_saps_path[qp][p].recent_err_count;
+			any_active[p] = 1;
+			if (ec > worst_err_count[p]) {
+				worst_err_count[p] = ec;
+			}
+			if (host_sapsq_state_rank(st) >
+			    host_sapsq_state_rank(worst_state[p])) {
+				worst_state[p] = st;
+				worst_fault[p] = ft;
+			} else if (host_sapsq_state_rank(st) ==
+				   host_sapsq_state_rank(worst_state[p]) &&
+				   ft != HOST_SAPS_FAULT_HEALTHY) {
+				worst_fault[p] = ft;
+			}
+		}
+	}
+
+	for (uint32_t p = 0; p < HOST_SAPS_QPATH_MAX; p++) {
+		uint32_t health_q16;
+		uint8_t  elig;
+		uint8_t  h_enum;
+		uint32_t hf_q16;
+		uint16_t st = any_active[p] ? worst_state[p] : DPA_SAPS_STATE_HEALTHY;
+		uint16_t ft = any_active[p] ? worst_fault[p] : HOST_SAPS_FAULT_HEALTHY;
+
+		switch (st) {
+		case DPA_SAPS_STATE_HEALTHY:
+			health_q16 = HOST_SAPS_HEALTH_HEALTHY_Q16;
+			elig = HOST_SAPS_ELIG_NORMAL;
+			cp->recover_ramp_q16[p] = 0;
+			break;
+		case DPA_SAPS_STATE_DEGRADING:
+			switch (ft) {
+			case HOST_SAPS_FAULT_PERPETUAL_SLOW:
+			case HOST_SAPS_FAULT_SPARSE_ERROR:
+				health_q16 = HOST_SAPS_HEALTH_PROBE_Q16;
+				elig = HOST_SAPS_ELIG_PROBE;
+				break;
+			case HOST_SAPS_FAULT_BIMODAL_TAIL: {
+				uint32_t base = 26214u; /* 0.4 */
+				/* Use the aggregated worst recent_err_count across all
+				 * QP rows (not just row 0) so the penalty reflects the
+				 * same rows the worst-state aggregation walked. */
+				uint32_t err = worst_err_count[p];
+				if (err > 64u) { err = 64u; }
+				uint32_t penalty = (err * 13107u) >> 6;
+				if (penalty > base) { penalty = base; }
+				health_q16 = base - penalty;
+				if (health_q16 < HOST_SAPS_HEALTH_PROBE_Q16) {
+					health_q16 = HOST_SAPS_HEALTH_PROBE_Q16;
+				}
+				elig = HOST_SAPS_ELIG_NORMAL;
+				break;
+			}
+			case HOST_SAPS_FAULT_FLAP:
+				health_q16 = 19660u; /* 0.3 */
+				elig = HOST_SAPS_ELIG_NORMAL;
+				break;
+			default:
+				health_q16 = 32768u; /* 0.5 */
+				elig = HOST_SAPS_ELIG_NORMAL;
+				break;
+			}
+			cp->recover_ramp_q16[p] = 0;
+			break;
+		case DPA_SAPS_STATE_EXCLUDED:
+			if (cp->probe_rate_q32 != 0) {
+				health_q16 = HOST_SAPS_HEALTH_PROBE_Q16;
+				elig = HOST_SAPS_ELIG_PROBE;
+			} else {
+				health_q16 = HOST_SAPS_HEALTH_QUARANTINE;
+				elig = HOST_SAPS_ELIG_QUARANTINE;
+			}
+			cp->recover_ramp_q16[p] = 0;
+			break;
+		case DPA_SAPS_STATE_RECOVERING: {
+			uint32_t cur = cp->recover_ramp_q16[p];
+			if (cur < HOST_SAPS_RECOVER_FLOOR_Q16) {
+				cur = HOST_SAPS_RECOVER_FLOOR_Q16;
+			} else if (cur < HOST_SAPS_HEALTH_HEALTHY_Q16) {
+				uint32_t next = cur + HOST_SAPS_RECOVER_STEP_Q16;
+				cur = (next > HOST_SAPS_HEALTH_HEALTHY_Q16)
+				      ? HOST_SAPS_HEALTH_HEALTHY_Q16 : next;
+			}
+			cp->recover_ramp_q16[p] = cur;
+			health_q16 = cur;
+			elig = HOST_SAPS_ELIG_NORMAL;
+			break;
+		}
+		default:
+			health_q16 = HOST_SAPS_HEALTH_HEALTHY_Q16;
+			elig = HOST_SAPS_ELIG_NORMAL;
+			break;
+		}
+
+		cp->path_health_q16[p] = health_q16;
+		cp->path_eligibility[p] = elig;
+
+		/* h_enum + health_factor mapping (mirror sapsq_compute_health tail). */
+		switch (st) {
+		case DPA_SAPS_STATE_HEALTHY:
+			h_enum = 0; hf_q16 = 65536u; break;
+		case DPA_SAPS_STATE_DEGRADING:
+			switch (ft) {
+			case HOST_SAPS_FAULT_PERPETUAL_SLOW:
+				h_enum = 2; hf_q16 = 6554u;  break;  /* 0.1 */
+			case HOST_SAPS_FAULT_BIMODAL_TAIL:
+				h_enum = 3; hf_q16 = 45875u; break;  /* 0.7 */
+			case HOST_SAPS_FAULT_SPARSE_ERROR:
+				h_enum = 4; hf_q16 = 3277u;  break;  /* 0.05 */
+			default:
+				h_enum = 1; hf_q16 = 32768u; break;  /* 0.5 */
+			}
+			break;
+		case DPA_SAPS_STATE_RECOVERING:
+			h_enum = 5; hf_q16 = 19661u; break;  /* 0.3 */
+		case DPA_SAPS_STATE_EXCLUDED:
+			h_enum = 6; hf_q16 = 0u;     break;
+		default:
+			h_enum = 0; hf_q16 = 65536u; break;
+		}
+		cp->path_health_enum[p] = h_enum;
+		cp->path_health_factor_q16[p] = hf_q16;
+	}
+}
+
+/* ── Per-tenant demand EWMA (port of sapsq_update_demand_ewma) ─────────────
+ * α = 0.125 (Q16.16 = 8192). Reads per-tenant submit_count delta over the
+ * epoch, converts to IO/s, EWMAs, and applies the cold-start demand floor. */
+#define HOST_SAPS_ALPHA_Q16  0x2000u
+#define HOST_SAPS_IDLE_HYSTERESIS_EPOCHS 3u
+
+static inline void host_sapsq_update_demand_ewma(struct host_sapsq_cp *cp,
+						 uint64_t dt_tsc)
+{
+	if (cp->tsc_freq == 0) {
+		return;
+	}
+	uint32_t num_t = cp->num_tenants;
+	if (num_t == 0 || num_t > HOST_SAPS_TENANT_MAX) {
+		num_t = HOST_SAPS_TENANT_MAX;
+	}
+
+	for (uint32_t t = 0; t < num_t; t++) {
+		uint64_t cur = cp->submit_count[t];
+		uint64_t delta = cur - cp->submit_last[t];
+		cp->submit_last[t] = cur;
+		uint32_t cnt = (delta > 0xFFFFFFFFu) ? 0xFFFFFFFFu : (uint32_t)delta;
+
+		uint64_t new_rate;
+		if (dt_tsc > 0) {
+			new_rate = ((uint64_t)cnt * cp->tsc_freq) / dt_tsc;
+		} else {
+			new_rate = 0;
+		}
+		if (new_rate > 0xFFFFFFFFu) {
+			new_rate = 0xFFFFFFFFu;
+		}
+
+		uint64_t old = cp->demand_ewma_q32[t];
+		uint64_t updated = ((uint64_t)HOST_SAPS_ALPHA_Q16 * new_rate
+				    + (uint64_t)(65536u - HOST_SAPS_ALPHA_Q16) * old)
+				   >> 16;
+		if (updated > 0xFFFFFFFFu) {
+			updated = 0xFFFFFFFFu;
+		}
+
+		if (cnt > 0) {
+			cp->zero_epochs[t] = 0;
+		} else if (cp->zero_epochs[t] < 0xFFFFFFFFu) {
+			cp->zero_epochs[t]++;
+		}
+
+		int truly_idle = (cp->zero_epochs[t] >= HOST_SAPS_IDLE_HYSTERESIS_EPOCHS);
+		if (cp->tenant_weight[t] > 0 && cp->link_cap_iops > 0 && !truly_idle) {
+			uint64_t floor_demand = cp->link_cap_iops;
+			if (updated < floor_demand) {
+				updated = floor_demand;
+			}
+		}
+
+		cp->demand_ewma_q32[t] = (uint32_t)updated;
+	}
+}
+
+/* ── Weighted max-min allocator (faithful port of sapsq_allocate) ──────────
+ *
+ * THE DOMINANT per-epoch cost: O(paths×tenants) + O(tenants log tenants) sort.
+ * Demand snapshot from demand_ewma_q32 (converted to Q32 IO/tsc), per-path cap
+ * from base × health, eligibility-aware progressive fill, second-pass split of
+ * saturated tenants, then per-path proportional split with probe floor.
+ * Output: cp->tenant_path_rate_q32[t][p] (Q0.32 IO/tsc, M4-compatible). */
+static inline void host_sapsq_allocate(struct host_sapsq_cp *cp)
+{
+	uint32_t num_t = cp->num_tenants;
+	if (num_t == 0 || num_t > HOST_SAPS_TENANT_MAX) {
+		num_t = HOST_SAPS_TENANT_MAX;
+	}
+	uint32_t num_p = cp->num_paths;
+	if (num_p == 0 || num_p > HOST_SAPS_QPATH_MAX) {
+		num_p = HOST_SAPS_QPATH_MAX;
+	}
+
+	uint32_t weight[HOST_SAPS_TENANT_MAX];
+	uint32_t demand[HOST_SAPS_TENANT_MAX];
+	uint64_t cap_q32[HOST_SAPS_QPATH_MAX];
+	uint8_t  elig[HOST_SAPS_QPATH_MAX];
+	uint32_t probe_q32_p[HOST_SAPS_QPATH_MAX];
+	uint32_t rate[HOST_SAPS_TENANT_MAX];
+	uint16_t active_idx[HOST_SAPS_TENANT_MAX];
+	uint8_t  saturated[HOST_SAPS_TENANT_MAX];
+	uint32_t n_active = 0;
+
+	uint64_t total_cap_q32 = 0;
+	uint64_t total_eligible_cap_q32 = 0;
+
+	/* Convert demand IO/s EWMA → Q0.32 IO/tsc (DPA sapsq_allocate consumes
+	 * sapsq_tenant_demand_q32 in Q32 IO/tsc; the M-series tick stores demand
+	 * as IO/s, so convert here to keep the allocator math identical). */
+	uint64_t tsc_freq = cp->tsc_freq ? cp->tsc_freq : 1500000000ULL;
+
+	for (uint32_t p = 0; p < HOST_SAPS_QPATH_MAX; p++) {
+		cap_q32[p] = 0;
+		elig[p] = HOST_SAPS_ELIG_QUARANTINE;
+		probe_q32_p[p] = 0;
+	}
+	for (uint32_t p = 0; p < num_p; p++) {
+		elig[p] = cp->path_eligibility[p];
+		probe_q32_p[p] = cp->probe_rate_q32;
+		uint64_t base = cp->path_base_iops_q32[p];
+		uint64_t hf   = cp->path_health_q16[p];
+		cap_q32[p] = (base * hf) >> 16;
+		if (elig[p] != HOST_SAPS_ELIG_QUARANTINE) {
+			total_cap_q32 += cap_q32[p];
+			total_eligible_cap_q32 += cap_q32[p];
+		}
+		cp->last_cap_eff_q32[p] = cap_q32[p];
+	}
+	cp->last_total_cap_q32 = total_cap_q32;
+
+	for (uint32_t t = 0; t < num_t; t++) {
+		weight[t] = cp->tenant_weight_q16[t];
+		uint64_t d_iops = cp->demand_ewma_q32[t];
+		uint64_t d_q32 = (d_iops << 32) / tsc_freq;
+		if (d_q32 > 0xFFFFFFFFu) {
+			d_q32 = 0xFFFFFFFFu;
+		}
+		demand[t] = (uint32_t)d_q32;
+		rate[t] = 0;
+		saturated[t] = 0;
+		if (weight[t] > 0 && demand[t] > 0) {
+			active_idx[n_active++] = (uint16_t)t;
+		}
+	}
+
+	if (n_active == 0 || total_cap_q32 == 0) {
+		for (uint32_t t = 0; t < num_t; t++) {
+			for (uint32_t p = 0; p < HOST_SAPS_QPATH_MAX; p++) {
+				cp->tenant_path_rate_q32[t][p] = 0;
+			}
+		}
+		return;
+	}
+
+	/* Insertion sort active_idx ascending by demand/weight (cross-product). */
+	for (uint32_t i = 1; i < n_active; i++) {
+		uint16_t key = active_idx[i];
+		uint64_t key_d = demand[key];
+		uint64_t key_w = weight[key];
+		int32_t j = (int32_t)i - 1;
+		while (j >= 0) {
+			uint16_t cur = active_idx[j];
+			uint64_t lhs = key_d * (uint64_t)weight[cur];
+			uint64_t rhs = (uint64_t)demand[cur] * key_w;
+			if (lhs < rhs) {
+				active_idx[j + 1] = cur;
+				j--;
+			} else {
+				break;
+			}
+		}
+		active_idx[j + 1] = key;
+	}
+
+	/* Progressive fill, first pass. */
+	uint64_t remaining_cap_q32 = total_cap_q32;
+	uint64_t remaining_weight_q16 = 0;
+	for (uint32_t i = 0; i < n_active; i++) {
+		remaining_weight_q16 += weight[active_idx[i]];
+	}
+
+	for (uint32_t i = 0; i < n_active; i++) {
+		uint16_t t = active_idx[i];
+		if (remaining_weight_q16 == 0) {
+			break;
+		}
+		uint64_t fair_q32 = (remaining_cap_q32 * (uint64_t)weight[t])
+				    / remaining_weight_q16;
+		if ((uint64_t)demand[t] <= fair_q32) {
+			if (remaining_cap_q32 < demand[t]) {
+				break;
+			}
+			rate[t] = demand[t];
+			remaining_cap_q32 -= demand[t];
+			remaining_weight_q16 -= weight[t];
+		} else {
+			saturated[t] = 1;
+		}
+	}
+
+	/* Second pass: saturated tenants split remaining capacity by weight. */
+	uint64_t sat_weight_q16 = 0;
+	for (uint32_t i = 0; i < n_active; i++) {
+		uint16_t t = active_idx[i];
+		if (saturated[t]) {
+			sat_weight_q16 += weight[t];
+		}
+	}
+	if (sat_weight_q16 > 0 && remaining_cap_q32 > 0) {
+		for (uint32_t i = 0; i < n_active; i++) {
+			uint16_t t = active_idx[i];
+			if (!saturated[t]) {
+				continue;
+			}
+			uint64_t share_q32 = (remaining_cap_q32 * (uint64_t)weight[t])
+					     / sat_weight_q16;
+			if (share_q32 > (uint64_t)demand[t]) {
+				share_q32 = demand[t];
+			}
+			rate[t] = (uint32_t)(share_q32 > 0xFFFFFFFFu
+					     ? 0xFFFFFFFFu : share_q32);
+		}
+	}
+
+	/* Path split: x_{t,p} = r_t × (C_p) / Σ_q C_q, with probe floor. */
+	for (uint32_t t = 0; t < num_t; t++) {
+		if (rate[t] == 0 || total_eligible_cap_q32 == 0) {
+			for (uint32_t p = 0; p < HOST_SAPS_QPATH_MAX; p++) {
+				cp->tenant_path_rate_q32[t][p] = 0;
+			}
+			continue;
+		}
+		for (uint32_t p = 0; p < HOST_SAPS_QPATH_MAX; p++) {
+			uint32_t x_q32;
+			if (p >= num_p || elig[p] == HOST_SAPS_ELIG_QUARANTINE ||
+			    cap_q32[p] == 0) {
+				x_q32 = 0;
+			} else {
+				uint64_t share = ((uint64_t)rate[t] * cap_q32[p])
+						 / total_eligible_cap_q32;
+				if (share > 0xFFFFFFFFu) {
+					share = 0xFFFFFFFFu;
+				}
+				x_q32 = (uint32_t)share;
+				if (elig[p] == HOST_SAPS_ELIG_PROBE &&
+				    x_q32 < probe_q32_p[p]) {
+					x_q32 = probe_q32_p[p];
+				}
+			}
+			cp->tenant_path_rate_q32[t][p] = x_q32;
+		}
+	}
+}
+
+/* ── M5 DRR round (port of m5_drr_round) ───────────────────────────────────
+ * Time-driven Deficit Round Robin: rate-based grant issuance with work-
+ * conserving idle detection via the grant/consumed gap. */
+static inline void host_m5_drr_round(struct host_sapsq_cp *cp, uint64_t now_tsc)
+{
+	if (!cp->m5_enabled) {
+		return;
+	}
+	uint64_t last = cp->m5_last_tsc;
+	uint64_t min_interval = cp->m5_interval_tsc;
+	if (min_interval == 0) {
+		min_interval = 100000ULL;
+	}
+	if (last != 0 && (now_tsc - last) < min_interval) {
+		return;
+	}
+	uint64_t delta_tsc = (last == 0) ? min_interval : (now_tsc - last);
+	if (delta_tsc > HOST_SAPS_DELTA_TSC_CAP) {
+		delta_tsc = HOST_SAPS_DELTA_TSC_CAP;
+	}
+	cp->m5_last_tsc = now_tsc;
+
+	uint32_t burst_mult = cp->m5_burst_mult;
+	if (burst_mult == 0) {
+		burst_mult = 2u;
+	}
+	const uint32_t M5_MIN_BURST_CAP = 128u;
+
+	uint32_t num_t = cp->num_tenants;
+	if (num_t == 0 || num_t > HOST_SAPS_TENANT_MAX) {
+		num_t = HOST_SAPS_TENANT_MAX;
+	}
+
+	for (uint32_t t = 0; t < num_t; t++) {
+		uint32_t rate_q32 = cp->m5_rate_q32[t];
+		if (rate_q32 == 0) {
+			continue;
+		}
+		uint64_t new_grants = ((uint64_t)rate_q32 * delta_tsc) >> 32;
+		if (new_grants == 0) {
+			continue;
+		}
+		uint32_t rate_per_interval =
+			(uint32_t)(((uint64_t)rate_q32 * min_interval) >> 32);
+		uint32_t burst_cap_grants = rate_per_interval * burst_mult;
+		if (burst_cap_grants < M5_MIN_BURST_CAP) {
+			burst_cap_grants = M5_MIN_BURST_CAP;
+		}
+
+		uint64_t grant    = cp->m5_grant_count[t];
+		uint64_t consumed = cp->m5_consumed_count[t];
+		uint64_t gap = (grant >= consumed) ? (grant - consumed) : 0;
+
+		if (gap >= (uint64_t)burst_cap_grants) {
+			int32_t def = cp->m5_deficit_q16[t];
+			if ((uint64_t)def + new_grants * (1u << 16) <
+			    (uint64_t)burst_cap_grants * (1u << 16)) {
+				def += (int32_t)(new_grants << 16);
+			}
+			if (def > (int32_t)(burst_cap_grants << 16)) {
+				def = (int32_t)(burst_cap_grants << 16);
+			}
+			cp->m5_deficit_q16[t] = def;
+			continue;
+		}
+
+		uint64_t max_issue = (uint64_t)burst_cap_grants - gap;
+		if (new_grants > max_issue) {
+			new_grants = max_issue;
+		}
+		int32_t def = cp->m5_deficit_q16[t];
+		if (def > 0) {
+			uint64_t bonus = (uint64_t)(uint32_t)def >> 16;
+			if (bonus > max_issue - new_grants) {
+				bonus = max_issue - new_grants;
+			}
+			new_grants += bonus;
+			def -= (int32_t)(bonus << 16);
+			if (def < 0) { def = 0; }
+			cp->m5_deficit_q16[t] = def;
+		}
+		cp->m5_grant_count[t] += new_grants;
+	}
+}
+
+/* ── Epoch driver (port of sapsq_run_epoch) ───────────────────────────────
+ * Triggered from the per-IO completion hook when elapsed host TSC since the
+ * last epoch >= epoch_period_tsc. Runs the full heavy control-plane pass on
+ * the reactor core: demand EWMA → health → weighted max-min allocate → publish.
+ * No PCIe writeback fence needed (single process, single reactor). */
+static inline void host_sapsq_run_epoch(struct host_sapsq_cp *cp, uint64_t now_tsc)
+{
+	if (!cp->enabled) {
+		return;
+	}
+	uint64_t last = cp->last_epoch_tsc;
+	uint64_t period = cp->epoch_period_tsc;
+	if (period == 0) {
+		period = 1500000ull;  /* 1 ms @ 1.5 GHz fallback */
+	}
+	uint64_t dt_tsc = (last == 0) ? period : (now_tsc - last);
+	if (last != 0 && dt_tsc < period) {
+		return;
+	}
+	cp->last_epoch_tsc = now_tsc;
+
+	/* (1) demand EWMA over the elapsed epoch. */
+	host_sapsq_update_demand_ewma(cp, dt_tsc);
+	/* (2) per-path health/eligibility from classifier FSM state. */
+	host_sapsq_compute_health(cp);
+	/* (3) weighted max-min allocation — DOMINANT O(T×P + T log T) cost. */
+	host_sapsq_allocate(cp);
+	/* (4) M5 DRR round (time-driven grant issuance). */
+	host_m5_drr_round(cp, now_tsc);
+
+	/* (5) publish: single-reactor → plain store, no fence. epoch++ is the
+	 * commit; token-bucket consumers read tenant_path_rate_q32 directly. */
+	cp->epoch++;
+	cp->epoch_run_count++;
+
+	/* In-run evidence (req #3): periodic dump so the smoke run shows epochs
+	 * firing + budgets computed even when bdevperf is killed with SIGKILL
+	 * (skips the shutdown dump). Stride keeps log volume bounded. */
+	if ((cp->epoch_run_count % 1000ull) == 1ull) {
+		host_saps_cp_debug_dump();
+	}
+}
+
+/* ── Host token-bucket admission (port of sapsq_refresh_and_consume_m) ─────
+ * Per-IO refresh+consume against the published (tenant,path) rate. Returns
+ * true = ADMIT, false = REJECT. Single-thread per qpair → no atomics. */
+static inline bool host_sapsq_refresh_and_consume(struct host_sapsq_cp *cp,
+						   uint32_t t, uint32_t p,
+						   uint32_t rate_q32,
+						   uint64_t now_tsc)
+{
+	uint64_t last_tsc = cp->tenant_path_refresh_tsc[t][p];
+	uint64_t dt_tsc = (last_tsc && now_tsc > last_tsc)
+			  ? (now_tsc - last_tsc) : 0ULL;
+	if (dt_tsc > HOST_SAPS_DELTA_TSC_CAP) {
+		dt_tsc = HOST_SAPS_DELTA_TSC_CAP;
+	}
+	uint64_t refill_q16 = ((uint64_t)rate_q32 * dt_tsc) >> 16;
+
+	uint64_t tsc_freq = cp->tsc_freq ? cp->tsc_freq : 1500000000ULL;
+	uint64_t burst_cap_q16 = ((uint64_t)rate_q32 * (tsc_freq / 10ULL)) >> 16;
+	if (burst_cap_q16 < (uint64_t)HOST_SAPS_Q16_ONE * 256ULL) {
+		burst_cap_q16 = (uint64_t)HOST_SAPS_Q16_ONE * 256ULL;
+	}
+
+	uint64_t tokens = (uint64_t)cp->tenant_path_tokens_q16[t][p];
+	tokens += refill_q16;
+	if (tokens > burst_cap_q16) {
+		tokens = burst_cap_q16;
+	}
+	if (tokens > 0xFFFFFFFFULL) {
+		tokens = 0xFFFFFFFFULL;
+	}
+	cp->tenant_path_refresh_tsc[t][p] = now_tsc;
+
+	if (tokens >= (uint64_t)HOST_SAPS_Q16_ONE) {
+		tokens -= (uint64_t)HOST_SAPS_Q16_ONE;
+		cp->tenant_path_tokens_q16[t][p] = (uint32_t)tokens;
+		return true;
+	}
+	cp->tenant_path_tokens_q16[t][p] = (uint32_t)tokens;
+	return false;
+}
+
+/* Per-IO control-plane hook: drive token consume + M3/M4/M5 bookkeeping.
+ * Runs on the reactor core for every admitted IO. Best-effort (the host_saps
+ * selector does not currently block on the verdict; this exercises the control
+ * plane's per-IO cost faithfully). */
+static inline void host_sapsq_on_submit(struct host_sapsq_cp *cp,
+					 uint16_t path_idx, uint64_t now_tsc,
+					 uint8_t retry_count)
+{
+	if (!cp->enabled) {
+		return;
+	}
+	uint32_t t = cp->my_tenant_id;
+	if (t >= HOST_SAPS_TENANT_MAX) {
+		t = 0;
+	}
+	/* Demand signal must mirror the latency-stats filter (only first-try
+	 * IO): submit_count feeds host_sapsq_update_demand_ewma, so counting
+	 * retried I/O would inflate a tenant's demand EWMA and distort the
+	 * weighted max-min allocation. The token-bucket / M3/M4/M5 consume below
+	 * still runs on retries because those are real wire submissions. */
+	if (retry_count == 0) {
+		cp->submit_count[t]++;
+	}
+
+	uint32_t p = path_idx;
+	if (p >= HOST_SAPS_QPATH_MAX) {
+		p = 0;
+	}
+
+	/* Token-bucket admission against the published rate. */
+	uint32_t rate_q32 = cp->tenant_path_rate_q32[t][p];
+	if (rate_q32 == 0) {
+		rate_q32 = cp->probe_rate_q32;
+	}
+	(void)host_sapsq_refresh_and_consume(cp, t, p, rate_q32, now_tsc);
+
+	/* M4 admission gate (per-IO token bucket). */
+	if (cp->m4_enabled) {
+		host_m4_refresh_and_consume(cp, t, now_tsc);
+	}
+	/* M3 credit ledger refresh+consume. */
+	if (cp->m3_enabled) {
+		host_m3_refresh_credit(cp, t, now_tsc);
+		(void)host_m3_consume(cp, t);
+	}
+	/* M5 DRR consume (host increments consumed when it has a grant). */
+	if (cp->m5_enabled) {
+		if (cp->m5_grant_count[t] > cp->m5_consumed_count[t]) {
+			cp->m5_consumed_count[t]++;
+		}
+	}
+}
+
+/* ── Control-plane config init from HOST_SAPS_* env (mirror DPA defaults) ── */
+
+static uint32_t host_saps_iops_to_q32(uint64_t iops, uint64_t tsc_freq)
+{
+	if (tsc_freq == 0) {
+		return 0;
+	}
+	uint64_t q = ((double)iops / (double)tsc_freq) * (double)(1ULL << 32);
+	if (q > 0xFFFFFFFFu) {
+		q = 0xFFFFFFFFu;
+	}
+	return (uint32_t)q;
+}
+
+static uint32_t host_saps_env_u32(const char *name, uint32_t dflt)
+{
+	const char *v = getenv(name);
+	if (!v || v[0] == '\0') {
+		return dflt;
+	}
+	char *end = NULL;
+	unsigned long parsed = strtoul(v, &end, 10);
+	if (end == v) {
+		return dflt;
+	}
+	return (uint32_t)parsed;
+}
+
+static void host_sapsq_cp_init(uint64_t tsc_freq)
+{
+	struct host_sapsq_cp *cp = &g_host_sapsq;
+	memset(cp, 0, sizeof(*cp));
+
+	cp->tsc_freq = tsc_freq ? tsc_freq : 1500000000ULL;
+
+	/* Config (own HOST_SAPS_* namespace; defaults mirror the DPA E2 setup so
+	 * the control plane runs even when the run scripts only set
+	 * HOST_SAPS_ENABLED=1). num_tenants supports up to HOST_SAPS_TENANT_MAX. */
+	uint32_t num_t = host_saps_env_u32("HOST_SAPS_NUM_TENANTS", 4u);
+	if (num_t == 0 || num_t > HOST_SAPS_TENANT_MAX) {
+		num_t = (num_t == 0) ? 1u : HOST_SAPS_TENANT_MAX;
+	}
+	uint32_t num_p = host_saps_env_u32("HOST_SAPS_NUM_PATHS", 3u);
+	if (num_p == 0 || num_p > HOST_SAPS_QPATH_MAX) {
+		num_p = (num_p == 0) ? 1u : HOST_SAPS_QPATH_MAX;
+	}
+	cp->num_tenants = num_t;
+	cp->num_paths = num_p;
+	cp->my_tenant_id = host_saps_env_u32("HOST_SAPS_MY_TENANT_ID", 0u);
+	if (cp->my_tenant_id >= HOST_SAPS_TENANT_MAX) {
+		cp->my_tenant_id = 0u;
+	}
+
+	const char *lc = getenv("HOST_SAPS_LINK_CAP_IOPS");
+	cp->link_cap_iops = (lc && lc[0]) ? strtoull(lc, NULL, 10) : 200000ULL;
+	if (cp->link_cap_iops == 0) {
+		cp->link_cap_iops = 200000ULL;
+	}
+
+	cp->epoch_period_us = host_saps_env_u32("HOST_SAPS_EPOCH_PERIOD_US", 1000u);
+	if (cp->epoch_period_us == 0) {
+		cp->epoch_period_us = 1000u;
+	}
+	cp->epoch_period_tsc =
+		((uint64_t)cp->epoch_period_us * cp->tsc_freq) / 1000000ULL;
+	if (cp->epoch_period_tsc == 0) {
+		cp->epoch_period_tsc = 1u;
+	}
+
+	uint32_t probe_iops = host_saps_env_u32("HOST_SAPS_PROBE_RATE_IOPS", 1000u);
+	cp->probe_rate_q32 = host_saps_iops_to_q32(probe_iops, cp->tsc_freq);
+
+	/* Weights: "3,1,1,1" plain integers; Q16.16 mirror for sapsq_allocate. */
+	const char *wt = getenv("HOST_SAPS_WEIGHTS");
+	uint32_t weights[HOST_SAPS_TENANT_MAX];
+	memset(weights, 0, sizeof(weights));
+	uint32_t n_w = 0;
+	if (wt && wt[0]) {
+		char buf[1024];
+		strncpy(buf, wt, sizeof(buf) - 1);
+		buf[sizeof(buf) - 1] = '\0';
+		char *tok = strtok(buf, ",");
+		while (tok && n_w < HOST_SAPS_TENANT_MAX) {
+			weights[n_w++] = (uint32_t)strtoul(tok, NULL, 10);
+			tok = strtok(NULL, ",");
+		}
+	}
+	if (n_w == 0) {
+		/* default 3:1:1:1 over the first 4 tenants, 1 elsewhere active. */
+		for (uint32_t t = 0; t < num_t; t++) {
+			weights[t] = (t == 0) ? 3u : 1u;
+		}
+		n_w = num_t;
+	}
+	for (uint32_t t = 0; t < HOST_SAPS_TENANT_MAX; t++) {
+		uint32_t w = (t < n_w) ? weights[t] : 0u;
+		cp->tenant_weight[t] = w;
+		cp->tenant_weight_q16[t] = w << 16;
+	}
+
+	/* Per-path base capacity = link_cap / num_paths, in Q0.32 IO/tsc. */
+	uint64_t per_path_iops = cp->link_cap_iops / (num_p ? num_p : 1u);
+	for (uint32_t p = 0; p < HOST_SAPS_QPATH_MAX; p++) {
+		cp->path_base_iops_q32[p] =
+			(p < num_p) ? host_saps_iops_to_q32(per_path_iops, cp->tsc_freq)
+				    : 0u;
+		cp->path_health_q16[p] = HOST_SAPS_HEALTH_HEALTHY_Q16;
+		cp->path_health_factor_q16[p] = HOST_SAPS_HEALTH_HEALTHY_Q16;
+		cp->path_eligibility[p] = HOST_SAPS_ELIG_NORMAL;
+	}
+
+	/* M3 capacity: link_cap / tsc_freq in Q32.32 (credits per tsc per unit w). */
+	if (cp->tsc_freq > 0) {
+		cp->m3_capacity_per_tsc_q32 =
+			(int64_t)(((double)cp->link_cap_iops / (double)cp->tsc_freq)
+				  * (double)(1ULL << 32));
+	}
+	cp->m3_credit_per_io_q32 = (int64_t)1 << 32;
+
+	/* M4 token-bucket per-tenant refill = (w/Σw) × link_cap, Q0.32 IO/tsc. */
+	uint64_t sum_w = 0;
+	for (uint32_t t = 0; t < HOST_SAPS_TENANT_MAX; t++) {
+		sum_w += cp->tenant_weight[t];
+	}
+	for (uint32_t t = 0; t < HOST_SAPS_TENANT_MAX; t++) {
+		uint64_t r_iops = (sum_w > 0)
+			? (cp->link_cap_iops * cp->tenant_weight[t]) / sum_w : 0;
+		cp->m4_refresh_per_tsc_q32[t] =
+			host_saps_iops_to_q32(r_iops, cp->tsc_freq);
+		cp->m4_burst_cap_q16[t] = 1000u << 16;  /* 1000 IO burst */
+		cp->m4_tokens_q16[t] = cp->m4_burst_cap_q16[t];
+		cp->m5_rate_q32[t] = cp->m4_refresh_per_tsc_q32[t];
+	}
+
+	cp->m5_burst_mult = host_saps_env_u32("HOST_SAPS_M5_BURST_MULT", 2u);
+	cp->m5_interval_tsc = ((uint64_t)100000u * cp->tsc_freq) / 1000000ULL;
+	if (cp->m5_interval_tsc == 0) {
+		cp->m5_interval_tsc = 1u;
+	}
+
+	cp->m3_enabled = host_saps_env_u32("HOST_SAPS_M3_ENABLED", 1u);
+	cp->m4_enabled = host_saps_env_u32("HOST_SAPS_M4_ENABLED", 1u);
+	cp->m5_enabled = host_saps_env_u32("HOST_SAPS_M5_DRR_ENABLED", 1u);
+	/* D-classifier bridge ON by default so health gates the allocator like
+	 * the DPA; set HOST_SAPS_BYPASS_D_CLASSIFIER=1 to force all-HEALTHY. */
+	cp->bypass_d_classifier =
+		host_saps_env_u32("HOST_SAPS_BYPASS_D_CLASSIFIER", 0u);
+
+	cp->enabled = 1;
+
+	SPDK_NOTICELOG("host_saps control plane active — tenants=%u paths=%u "
+		       "link_cap=%lu IOPS epoch=%u us (%lu tsc) tenant_max=%u "
+		       "m3=%u m4=%u m5=%u bypass_d=%u\n",
+		       cp->num_tenants, cp->num_paths,
+		       (unsigned long)cp->link_cap_iops, cp->epoch_period_us,
+		       (unsigned long)cp->epoch_period_tsc, HOST_SAPS_TENANT_MAX,
+		       cp->m3_enabled, cp->m4_enabled, cp->m5_enabled,
+		       cp->bypass_d_classifier);
+}
+
+/* Debug evidence reader (task req #3): expose epoch count + sample budgets so
+ * the smoke run can prove the control plane executed on the host reactor. */
+void host_saps_cp_debug_dump(void)
+{
+	struct host_sapsq_cp *cp = &g_host_sapsq;
+	if (!cp->enabled) {
+		SPDK_NOTICELOG("host_saps control plane: INACTIVE\n");
+		return;
+	}
+	uint32_t t = cp->my_tenant_id;
+	if (t >= HOST_SAPS_TENANT_MAX) {
+		t = 0;
+	}
+	SPDK_NOTICELOG("host_saps CP epochs=%lu m4_admit=%lu m4_reject=%lu "
+		       "total_cap_q32=%lu cap_eff=[%lu,%lu,%lu] "
+		       "my_tid=%u rate_q32=[%u,%u,%u] health_q16=[%u,%u,%u]\n",
+		       (unsigned long)cp->epoch_run_count,
+		       (unsigned long)cp->m4_admit_count,
+		       (unsigned long)cp->m4_reject_count,
+		       (unsigned long)cp->last_total_cap_q32,
+		       (unsigned long)cp->last_cap_eff_q32[0],
+		       (unsigned long)cp->last_cap_eff_q32[1],
+		       (unsigned long)cp->last_cap_eff_q32[2],
+		       t,
+		       cp->tenant_path_rate_q32[t][0],
+		       cp->tenant_path_rate_q32[t][1],
+		       cp->tenant_path_rate_q32[t][2],
+		       cp->path_health_q16[0],
+		       cp->path_health_q16[1],
+		       cp->path_health_q16[2]);
+
+	/* Robust evidence sink: SPDK NOTICELOG is sometimes routed to syslog and
+	 * the smoke harness kills bdevperf with SIGKILL (no clean shutdown). Append
+	 * the same line to a file (flushed each call) so the epoch count + budgets
+	 * are recoverable regardless. Path override: HOST_SAPS_CP_EVIDENCE_FILE. */
+	const char *path = getenv("HOST_SAPS_CP_EVIDENCE_FILE");
+	if (!path || path[0] == '\0') {
+		path = "/tmp/host_saps_cp_evidence.log";
+	}
+	FILE *f = fopen(path, "a");
+	if (f) {
+		fprintf(f,
+			"host_saps CP epochs=%lu m4_admit=%lu m4_reject=%lu "
+			"total_cap_q32=%lu cap_eff=[%lu,%lu,%lu] my_tid=%u "
+			"rate_q32=[%u,%u,%u] health_q16=[%u,%u,%u]\n",
+			(unsigned long)cp->epoch_run_count,
+			(unsigned long)cp->m4_admit_count,
+			(unsigned long)cp->m4_reject_count,
+			(unsigned long)cp->last_total_cap_q32,
+			(unsigned long)cp->last_cap_eff_q32[0],
+			(unsigned long)cp->last_cap_eff_q32[1],
+			(unsigned long)cp->last_cap_eff_q32[2],
+			t,
+			cp->tenant_path_rate_q32[t][0],
+			cp->tenant_path_rate_q32[t][1],
+			cp->tenant_path_rate_q32[t][2],
+			cp->path_health_q16[0],
+			cp->path_health_q16[1],
+			cp->path_health_q16[2]);
+		fclose(f);
+	}
+}
+
+uint64_t host_saps_cp_epoch_count(void)
+{
+	return g_host_sapsq.enabled ? g_host_sapsq.epoch_run_count : 0;
+}
+
+/* ─── Public API ───────────────────────────────────────────────────────── */
+
+int host_saps_init(void)
+{
+	const char *en = getenv("HOST_SAPS_ENABLED");
+	if (!en || en[0] != '1') {
+		g_host_saps_active = 0;
+		return 0;
+	}
+	/* Initialise wall-clock conversion. spdk_get_ticks_hz() must already be
+	 * valid (caller invokes after spdk env init). */
+	uint64_t hz = spdk_get_ticks_hz();
+	if (hz == 0) {
+		g_host_saps_ticks_per_ms = SAPS_TICKS_PER_MS_FALLBACK;
+	} else {
+		g_host_saps_ticks_per_ms = hz / 1000ull;
+		if (g_host_saps_ticks_per_ms == 0) {
+			g_host_saps_ticks_per_ms = SAPS_TICKS_PER_MS_FALLBACK;
+		}
+	}
+
+	/* Zero verdict tables — mirrors DPA shared ring memset on attach. */
+	memset(g_host_saps_path,                    0, sizeof(g_host_saps_path));
+	memset(g_host_saps_path_score,              0, sizeof(g_host_saps_path_score));
+	memset(g_host_saps_path_score_opcode,       0, sizeof(g_host_saps_path_score_opcode));
+	memset(g_host_saps_path_state_pub,          0, sizeof(g_host_saps_path_state_pub));
+	memset(g_host_saps_path_retry_verdict,    0xFF, sizeof(g_host_saps_path_retry_verdict));
+	memset(g_host_saps_ctrlr_slots,             0, sizeof(g_host_saps_ctrlr_slots));
+	memset(g_host_saps_submit_tsc_low,          0, sizeof(g_host_saps_submit_tsc_low));
+	memset(g_host_saps_trace_count,             0, sizeof(g_host_saps_trace_count));
+
+	const char *trace = getenv("SAPS_TRACE");
+	g_host_saps_trace = trace && trace[0] == '1';
+	const char *stride = getenv("SAPS_TRACE_STRIDE");
+	if (stride && stride[0] != '\0') {
+		char *end = NULL;
+		uint64_t parsed = strtoull(stride, &end, 10);
+		if (end != stride && parsed != 0) {
+			g_host_saps_trace_stride = parsed;
+		}
+	}
+
+	g_host_saps_active = 1;
+	SPDK_NOTICELOG("host_saps active — ticks_per_ms=%lu trace=%d stride=%lu\n",
+		       (unsigned long)g_host_saps_ticks_per_ms, g_host_saps_trace,
+		       (unsigned long)g_host_saps_trace_stride);
+
+	/* Bring up the SAPS QoS control plane on the host reactor. Uses the
+	 * actual host TSC frequency (ticks_per_ms × 1000) for all rate/period
+	 * fixed-point conversions. */
+	host_sapsq_cp_init(g_host_saps_ticks_per_ms * 1000ull);
+	return 0;
+}
+
+void host_saps_shutdown(void)
+{
+	/* Dump control-plane evidence before tearing down (req #3): proves the
+	 * epoch ran on the host reactor and budgets were computed. */
+	host_saps_cp_debug_dump();
+	g_host_saps_active = 0;
+}
+
+int host_saps_active(void) { return g_host_saps_active; }
+
+void host_saps_on_io_submit(uint16_t cmd_id, uint8_t opcode, uint16_t qp_id,
+			     uint16_t path_id, uint32_t nbytes, uint32_t nsid,
+			     uint8_t retry_count, uint64_t host_tsc)
+{
+	(void)nbytes; (void)nsid;  /* retry_count used by demand filter below */
+	if (!g_host_saps_active) { return; }
+	uint16_t qp_idx   = (uint16_t)((uint32_t)qp_id   & DPA_PLUGIN_CONN_MASK);
+	uint16_t path_idx = (uint16_t)((uint32_t)path_id & DPA_PLUGIN_PATH_MASK);
+	uint32_t submit_slot = host_saps_submit_slot(cmd_id, qp_idx, path_idx);
+	g_host_saps_submit_tsc_low[submit_slot] = (uint32_t)host_tsc;
+	g_host_saps_submit_tag[submit_slot] = host_saps_submit_tag(qp_idx, path_idx);
+	saps_update_submit(qp_idx, path_idx, opcode);
+
+	/* Control plane: per-IO token-bucket consume + M3/M4/M5 bookkeeping on
+	 * the reactor core (the host CPU cost we are measuring vs DPA offload). */
+	host_sapsq_on_submit(&g_host_sapsq, path_idx, host_tsc, retry_count);
+}
+
+void host_saps_on_io_complete(uint16_t cmd_id, uint8_t opcode, uint16_t qp_id,
+			       uint16_t path_id, uint16_t sct_sc,
+			       uint32_t nbytes, uint32_t nsid,
+			       uint8_t retry_count, uint64_t host_tsc)
+{
+	(void)nbytes; (void)nsid;
+	if (!g_host_saps_active) { return; }
+	uint16_t qp_idx   = (uint16_t)((uint32_t)qp_id   & DPA_PLUGIN_CONN_MASK);
+	uint16_t path_idx = (uint16_t)((uint32_t)path_id & DPA_PLUGIN_PATH_MASK);
+
+	/* Per-cmd_id latency lookup (mirror DPA g_submit_tsc_low). */
+	uint32_t submit_slot = host_saps_submit_slot(cmd_id, qp_idx, path_idx);
+	uint32_t submit_low = g_host_saps_submit_tsc_low[submit_slot];
+	uint16_t stored_tag = g_host_saps_submit_tag[submit_slot];
+	uint16_t expect_tag = host_saps_submit_tag(qp_idx, path_idx);
+	uint32_t now_low = (uint32_t)host_tsc;
+	uint32_t delta_ticks = 0;
+	g_host_saps_submit_tsc_low[submit_slot] = 0;
+	g_host_saps_submit_tag[submit_slot] = 0;
+
+	/* have_lat_sample is false when there is no matching submit:
+	 *   (a) submit_low == 0 — empty slot (first complete after init), or
+	 *   (b) stored_tag != expect_tag — the slot is owned by a DIFFERENT
+	 *       (qp_idx, path_idx) that aliased into the same 64K slot (the
+	 *       slot key only folds 2 bits of the 10-bit qp). Consuming this
+	 *       timestamp would attribute another path's latency to ours.
+	 * In both cases we SKIP the latency sample entirely instead of feeding
+	 * a fake delta_ticks=1, which previously biased the baseline down. The
+	 * error/inflight bookkeeping in saps_update_complete still runs. */
+	bool have_lat_sample = (submit_low != 0) && (stored_tag == expect_tag);
+	if (have_lat_sample) {
+		delta_ticks = now_low - submit_low; /* uint32 wrap-safe diff */
+		if (delta_ticks == 0) { delta_ticks = 1; }
+	}
+
+	saps_update_complete(qp_idx, path_idx, opcode, sct_sc,
+			     retry_count, host_tsc, delta_ticks, have_lat_sample);
+
+	/* Control plane epoch driver. The DPA runs the scheduler on its own event
+	 * loop via TSC boundaries (sapsq_scheduler_tick); on the host we replicate
+	 * that by checking elapsed TSC inside this per-IO completion hook so the
+	 * heavy weighted max-min allocation runs ON the reactor core every epoch
+	 * (req #2). host_sapsq_run_epoch is a no-op until the period elapses. */
+	host_sapsq_run_epoch(&g_host_sapsq, host_tsc);
+}
+
+uint32_t host_saps_read_path_score(uint16_t qp_id, uint16_t path_id)
+{
+	if (!g_host_saps_active) { return 0; }
+	uint32_t qp_slot = (uint32_t)qp_id & DPA_PLUGIN_CONN_MASK;
+	uint32_t path_slot = (uint32_t)path_id & DPA_PLUGIN_PATH_MASK;
+	return g_host_saps_path_score[qp_slot][path_slot];
+}
+
+uint32_t host_saps_read_path_score_opcode(uint16_t qp_id, uint16_t path_id,
+					  uint8_t opcode_class)
+{
+	if (!g_host_saps_active) { return 0; }
+	if (opcode_class >= DPA_PLUGIN_OPC_CLASS_MAX) { return 0; }
+	uint32_t qp_slot = (uint32_t)qp_id & DPA_PLUGIN_CONN_MASK;
+	uint32_t path_slot = (uint32_t)path_id & DPA_PLUGIN_PATH_MASK;
+	return g_host_saps_path_score_opcode[qp_slot][path_slot][opcode_class];
+}
+
+uint32_t host_saps_read_path_opc_p99(uint16_t qp_id, uint16_t path_id,
+				     uint8_t opcode_class)
+{
+	if (!g_host_saps_active) { return 0; }
+	if (opcode_class >= DPA_PLUGIN_OPC_CLASS_MAX) { return 0; }
+	uint32_t qp_slot = (uint32_t)qp_id & DPA_PLUGIN_CONN_MASK;
+	uint32_t path_slot = (uint32_t)path_id & DPA_PLUGIN_PATH_MASK;
+	struct host_saps_path_state *p = &g_host_saps_path[qp_slot][path_slot];
+
+	if (p->opc_p99[opcode_class].n <= SAPS_WARMUP_N ||
+	    p->opc_p99[opcode_class].p99 <= 0) {
+		return 0;
+	}
+	return (uint32_t)(p->opc_p99[opcode_class].p99 & 0xFFFFFFFF);
+}
+
+void host_saps_prefetch_path_score_row(uint16_t qp_id)
+{
+	if (!g_host_saps_active) { return; }
+	uint32_t qp_slot = (uint32_t)qp_id & DPA_PLUGIN_CONN_MASK;
+	__builtin_prefetch((const void *)&g_host_saps_path_score[qp_slot][0], 0, 3);
+}
+
+uint8_t host_saps_read_retry_verdict(uint16_t qp_id, uint16_t path_id)
+{
+	if (!g_host_saps_active) { return DPA_SAPS_ACTION_UNSET; }
+	uint32_t qp_slot = (uint32_t)qp_id & DPA_PLUGIN_CONN_MASK;
+	uint32_t path_slot = (uint32_t)path_id & DPA_PLUGIN_PATH_MASK;
+	return g_host_saps_path_retry_verdict[qp_slot][path_slot];
+}
+
+uint16_t host_saps_read_path_state(uint16_t qp_id, uint16_t path_id)
+{
+	if (!g_host_saps_active) { return DPA_SAPS_STATE_HEALTHY; }
+	uint32_t qp_slot = (uint32_t)qp_id & DPA_PLUGIN_CONN_MASK;
+	uint32_t path_slot = (uint32_t)path_id & DPA_PLUGIN_PATH_MASK;
+	return g_host_saps_path_state_pub[qp_slot][path_slot];
+}
+
+uint16_t host_saps_read_path_fault_type(uint16_t qp_id, uint16_t path_id)
+{
+	if (!g_host_saps_active) { return HOST_SAPS_FAULT_HEALTHY; }
+	uint32_t qp_slot = (uint32_t)qp_id & DPA_PLUGIN_CONN_MASK;
+	uint32_t path_slot = (uint32_t)path_id & DPA_PLUGIN_PATH_MASK;
+	return g_host_saps_path[qp_slot][path_slot].fault_type;
+}
diff --git a/lib/nvme/nvme_rdma.c b/lib/nvme/nvme_rdma.c
index 6ea0be8aa..463d60ca5 100644
--- a/lib/nvme/nvme_rdma.c
+++ b/lib/nvme/nvme_rdma.c
@@ -28,6 +28,11 @@
 #include "spdk_internal/rdma_utils.h"
 #include "spdk_internal/sgl.h"
 
+#ifdef DPA_PLUGIN_ENABLED
+#include "dpa_plugin.h"   /* P0.3 host-side plugin interface */
+#include "host_saps.h"    /* Phase A — host-only SAPS (mode b) */
+#endif
+
 #define NVME_RDMA_TIME_OUT_IN_MS 2000
 #define NVME_RDMA_RW_BUFFER_SIZE 131072
 
@@ -450,6 +455,43 @@ nvme_rdma_req_complete(struct spdk_nvme_rdma_req *rdma_req,
 
 	nvme_rdma_qpair_remove_req(rqpair, rdma_req);
 
+#ifdef DPA_PLUGIN_ENABLED
+	/* P0.3 completion hook — fire before app callback so we can observe
+	 * per-IO latency without competing with upper-layer processing.
+	 *
+	 * Mode dispatch (Phase A): host_saps and dpa_plugin are mutually
+	 * exclusive at runtime. Both hooks are zero-cost when their
+	 * respective active flag is 0, but we still gate on host_saps_active()
+	 * first to keep the dpa_plugin notify ring untouched in mode (b). */
+	/* sct_sc encoding: the SAPS classifier (schema v2) expects (sct<<8)|sc.
+	 * rsp->status_raw is the packed NVMe status bitfield (p:1, sc:8, sct:3,
+	 * crd:2, m:1, dnr:1), so feeding status_raw directly mis-decodes — e.g.
+	 * sct=2/sc=0x81 has status_raw=0x0502 which (>>8,&0xFF) reads as
+	 * sct=5/sc=0x02. Repack from the bitfield so downstream sct/sc-aware
+	 * logic (D3 sct=2/sc=0x81 TERMINAL->FAILOVER override) is correct. */
+	uint16_t saps_sct_sc = (uint16_t)(((uint16_t)rsp->status.sct << 8) |
+					   (uint16_t)rsp->status.sc);
+	if (host_saps_active()) {
+		host_saps_on_io_complete(rdma_req->id, req->cmd.opc,
+					  qpair->id,
+					  host_saps_ctrlr_to_path_idx(qpair->ctrlr),
+					  saps_sct_sc,
+					  req->payload.size,
+					  req->cmd.nsid,
+					  req->retries,
+					  spdk_get_ticks());
+	} else {
+		dpa_plugin_on_io_complete(rdma_req->id, req->cmd.opc,
+					   qpair->id,
+					   dpa_plugin_ctrlr_to_path_idx(qpair->ctrlr),
+					   saps_sct_sc,
+					   req->payload.size,
+					   req->cmd.nsid,
+					   req->retries,
+					   spdk_get_ticks());
+	}
