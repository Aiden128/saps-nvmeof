+static void
+test_nvmf_rdma_saps_delay_config(void)
+{
+	struct nvmf_rdma_saps_delay_stats stats = {};
+	int rc;
+
+	rc = nvmf_rdma_saps_delay_set(4807, 5000);
+	CU_ASSERT(rc == 0);
+	nvmf_rdma_saps_delay_get(&stats);
+	CU_ASSERT(stats.enabled);
+	CU_ASSERT(stats.trsvcid == 4807);
+	CU_ASSERT(stats.delay_us == 5000);
+	CU_ASSERT(stats.generation != 0);
+	CU_ASSERT(stats.delayed_requests == 0);
+	CU_ASSERT(stats.pending_requests == 0);
+
+	rc = nvmf_rdma_saps_delay_set(70000, 5000);
+	CU_ASSERT(rc == -EINVAL);
+
+	rc = nvmf_rdma_saps_delay_set(4807, 0);
+	CU_ASSERT(rc == 0);
+	nvmf_rdma_saps_delay_get(&stats);
+	CU_ASSERT(!stats.enabled);
+	CU_ASSERT(stats.delay_us == 0);
+}
+
+static void
+test_nvmf_rdma_saps_delay_request_lifecycle(void)
+{
+	struct spdk_nvmf_rdma_transport rtransport = {};
+	struct spdk_nvmf_transport_ops ops = {};
+	struct spdk_nvmf_rdma_poll_group group = {};
+	struct spdk_nvmf_rdma_poller poller = {};
+	struct spdk_nvmf_rdma_device device = {};
+	struct spdk_nvmf_rdma_resources resources = {};
+	struct spdk_nvmf_rdma_qpair rqpair = {};
+	struct spdk_nvmf_rdma_recv *rdma_recv;
+	struct spdk_nvmf_rdma_request *rdma_req;
+	struct nvmf_rdma_saps_delay_stats stats = {};
+	struct spdk_iobuf_channel ch = {};
+	union nvmf_h2c_msg *cmd;
+
+	group.group.buf_cache = &ch;
+	STAILQ_INIT(&group.group.pending_buf_queue);
+	poller_reset(&poller, &group);
+	qpair_reset(&rqpair, &poller, &device, &resources, &rtransport.transport);
+	rqpair.saps_listen_port = 4807;
+
+	rtransport.transport.opts = g_rdma_ut_transport_opts;
+	rtransport.data_wr_pool = spdk_mempool_create("test_saps_delay_wr_pool", 128,
+				  sizeof(struct spdk_nvmf_rdma_request_data), 0, 0);
+	rtransport.transport.ops = &ops;
+	device.map = (void *)0x0;
+	MOCK_CLEAR(spdk_iobuf_get);
+	MOCK_SET(spdk_get_ticks, 1000);
+
+	/* Matching I/O waits without blocking the qpair poller, then executes. */
+	CU_ASSERT(nvmf_rdma_saps_delay_set(4807, 100) == 0);
+	rdma_recv = create_recv(&rqpair, SPDK_NVME_OPC_READ);
+	rdma_req = create_req(&rqpair, rdma_recv);
+	rqpair.current_recv_depth = 1;
+	CU_ASSERT(nvmf_rdma_request_process(&rtransport, rdma_req));
+	CU_ASSERT(rdma_req->state == RDMA_REQUEST_STATE_SAPS_DELAY_PENDING);
+	CU_ASSERT(rdma_req == STAILQ_FIRST(&rqpair.pending_saps_delay_queue));
+
+	nvmf_rdma_qpair_process_pending(&rtransport, &rqpair, false);
+	CU_ASSERT(rdma_req->state == RDMA_REQUEST_STATE_SAPS_DELAY_PENDING);
+
+	MOCK_SET(spdk_get_ticks, 1100);
+	nvmf_rdma_qpair_process_pending(&rtransport, &rqpair, false);
+	CU_ASSERT(rdma_req->state == RDMA_REQUEST_STATE_EXECUTING);
+	CU_ASSERT(STAILQ_EMPTY(&rqpair.pending_saps_delay_queue));
+	nvmf_rdma_saps_delay_get(&stats);
+	CU_ASSERT(stats.delayed_requests == 1);
+	CU_ASSERT(stats.expired_requests == 1);
+	CU_ASSERT(stats.pending_requests == 0);
+
+	rdma_req->state = RDMA_REQUEST_STATE_COMPLETED;
+	CU_ASSERT(nvmf_rdma_request_process(&rtransport, rdma_req));
+	CU_ASSERT(rdma_req->state == RDMA_REQUEST_STATE_FREE);
+	CU_ASSERT(!rdma_req->saps_delay_applied);
+	free_recv(rdma_recv);
+	free_req(rdma_req);
+
+	/* A disconnect removes the request from the dedicated delay queue. */
+	memset(&resources, 0, sizeof(resources));
+	qpair_reset(&rqpair, &poller, &device, &resources, &rtransport.transport);
+	rqpair.saps_listen_port = 4807;
+	CU_ASSERT(nvmf_rdma_saps_delay_set(4807, 100) == 0);
+	rdma_recv = create_recv(&rqpair, SPDK_NVME_OPC_READ);
+	rdma_req = create_req(&rqpair, rdma_recv);
+	rqpair.current_recv_depth = 1;
+	CU_ASSERT(nvmf_rdma_request_process(&rtransport, rdma_req));
+	CU_ASSERT(rdma_req->state == RDMA_REQUEST_STATE_SAPS_DELAY_PENDING);
+	rqpair.ibv_in_error_state = true;
+	CU_ASSERT(nvmf_rdma_request_process(&rtransport, rdma_req));
+	CU_ASSERT(rdma_req->state == RDMA_REQUEST_STATE_FREE);
+	CU_ASSERT(STAILQ_EMPTY(&rqpair.pending_saps_delay_queue));
+	nvmf_rdma_saps_delay_get(&stats);
+	CU_ASSERT(stats.disconnected_requests == 1);
+	CU_ASSERT(stats.pending_requests == 0);
+	free_recv(rdma_recv);
+	free_req(rdma_req);
+
+	/* Admin, Fabric, and fused commands never enter the experiment queue. */
+	memset(&resources, 0, sizeof(resources));
+	qpair_reset(&rqpair, &poller, &device, &resources, &rtransport.transport);
+	rqpair.saps_listen_port = 4807;
+	rqpair.qpair.qid = 0;
+	rdma_recv = create_recv(&rqpair, SPDK_NVME_OPC_READ);
+	rdma_req = create_req(&rqpair, rdma_recv);
