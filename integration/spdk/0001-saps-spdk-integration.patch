diff --git a/module/bdev/bimodal_delay/vbdev_bimodal_delay.c b/module/bdev/bimodal_delay/vbdev_bimodal_delay.c
new file mode 100644
index 000000000..bedce2e08
--- /dev/null
+++ b/module/bdev/bimodal_delay/vbdev_bimodal_delay.c
@@ -0,0 +1,743 @@
+/*   SPDX-License-Identifier: BSD-3-Clause
+ *   Bimodal delay bdev — D4 fault injection tool.
+ *
+ *   Each IO is routed to either the fast or slow completion queue based on a
+ *   per-channel xorshift64 RNG.  The split is controlled by p_slow_ppm
+ *   (parts per million), default 150000 = 15%.
+ *
+ *   Architecture mirrors bdev_delay to minimise diff/review burden.
+ */
+
+#include "spdk/stdinc.h"
+#include "vbdev_bimodal_delay.h"
+#include "spdk/rpc.h"
+#include "spdk/env.h"
+#include "spdk/endian.h"
+#include "spdk/string.h"
+#include "spdk/thread.h"
+#include "spdk/util.h"
+#include "spdk/bdev_module.h"
+#include "spdk/log.h"
+
+#define BDEV_BIMODAL_NAMESPACE_UUID "7a3c1d2e-84f0-4b9e-bc22-ef901234abcd"
+
+/* ---- module lifecycle ---- */
+static int  vbdev_bimodal_init(void);
+static int  vbdev_bimodal_get_ctx_size(void);
+static void vbdev_bimodal_examine(struct spdk_bdev *bdev);
+static void vbdev_bimodal_finish(void);
+static int  vbdev_bimodal_config_json(struct spdk_json_write_ctx *w);
+
+static struct spdk_bdev_module bimodal_if = {
+	.name          = "bimodal_delay",
+	.module_init   = vbdev_bimodal_init,
+	.get_ctx_size  = vbdev_bimodal_get_ctx_size,
+	.examine_config = vbdev_bimodal_examine,
+	.module_fini   = vbdev_bimodal_finish,
+	.config_json   = vbdev_bimodal_config_json,
+};
+SPDK_BDEV_MODULE_REGISTER(bimodal_delay, &bimodal_if)
+
+/* ---- per-bdev association (pre-registration config) ---- */
+struct bimodal_association {
+	char			*vbdev_name;
+	char			*bdev_name;
+	struct spdk_uuid	uuid;
+	uint64_t		fast_lat_us;
+	uint64_t		slow_lat_us;
+	uint32_t		p_slow_ppm;   /* parts-per-million, 0..1000000 */
+	TAILQ_ENTRY(bimodal_association) link;
+};
+static TAILQ_HEAD(, bimodal_association) g_assoc = TAILQ_HEAD_INITIALIZER(g_assoc);
+
+/* ---- live bdev node ---- */
+struct vbdev_bimodal {
+	struct spdk_bdev	*base_bdev;
+	struct spdk_bdev_desc	*base_desc;
+	struct spdk_bdev	bdev;
+	/* latency in ticks */
+	uint64_t		fast_ticks;
+	uint64_t		slow_ticks;
+	/* slow probability: IO is slow if xorshift64() % 1000000 < p_slow_ppm */
+	uint32_t		p_slow_ppm;
+	TAILQ_ENTRY(vbdev_bimodal) link;
+	struct spdk_thread	*thread;
+};
+static TAILQ_HEAD(, vbdev_bimodal) g_bimodal_nodes = TAILQ_HEAD_INITIALIZER(g_bimodal_nodes);
+
+/* ---- per-IO context (fits in spdk_bdev_io driver_ctx) ---- */
+struct bimodal_io {
+	int			status;
+	uint64_t		completion_tick;
+	bool			is_slow;
+	struct spdk_io_channel	*ch;
+	struct spdk_bdev_io_wait_entry bdev_io_wait;
+	struct spdk_bdev_io	*zcopy_bdev_io;
+	STAILQ_ENTRY(bimodal_io) link;
+};
+
+/* ---- per-channel state ---- */
+struct bimodal_ch {
+	struct spdk_io_channel	*base_ch;
+	STAILQ_HEAD(, bimodal_io) fast_ios;
+	STAILQ_HEAD(, bimodal_io) slow_ios;
+	struct spdk_poller	*poller;
+	uint64_t		rng;   /* xorshift64 state, seeded at channel create */
+};
+
+/* ---- xorshift64 (Marsaglia 2003) — no FPU, no libc rand ---- */
+static inline uint64_t
+xorshift64(uint64_t *state)
+{
+	uint64_t x = *state;
+	x ^= x << 13;
+	x ^= x >> 7;
+	x ^= x << 17;
+	*state = x;
+	return x;
+}
+
+static inline bool
+is_slow_io(struct bimodal_ch *ch, uint32_t p_slow_ppm)
+{
+	/* xorshift64 % 1000000: uniform on [0,999999].
+	 * IO is slow iff result < p_slow_ppm. */
+	return (xorshift64(&ch->rng) % 1000000ULL) < p_slow_ppm;
+}
+
+/* ---- IO completion poller ---- */
+static int
+_process_bimodal_stailq(void *arg, uint64_t ticks)
+{
+	STAILQ_HEAD(, bimodal_io) *head = arg;
+	struct bimodal_io *io_ctx, *tmp;
+	int done = 0;
+
+	STAILQ_FOREACH_SAFE(io_ctx, head, link, tmp) {
+		if (io_ctx->completion_tick <= ticks) {
+			STAILQ_REMOVE(head, io_ctx, bimodal_io, link);
+			spdk_bdev_io_complete(spdk_bdev_io_from_ctx(io_ctx), io_ctx->status);
+			done++;
+		} else {
+			break;
+		}
+	}
+	return done;
+}
+
+static int
+_bimodal_finish_io(void *arg)
+{
+	struct bimodal_ch *ch = arg;
+	uint64_t ticks = spdk_get_ticks();
+	int done = 0;
+
+	done += _process_bimodal_stailq(&ch->fast_ios, ticks);
+	done += _process_bimodal_stailq(&ch->slow_ios, ticks);
+	return done == 0 ? SPDK_POLLER_IDLE : SPDK_POLLER_BUSY;
+}
+
+/* ---- base bdev completion callback ---- */
+static void
+_bimodal_complete_io(struct spdk_bdev_io *bdev_io, bool success, void *cb_arg)
+{
+	struct spdk_bdev_io *orig_io = cb_arg;
+	struct vbdev_bimodal *node = SPDK_CONTAINEROF(orig_io->bdev, struct vbdev_bimodal, bdev);
+	struct bimodal_io *io_ctx = (struct bimodal_io *)orig_io->driver_ctx;
+	struct bimodal_ch *ch = spdk_io_channel_get_ctx(io_ctx->ch);
+
+	io_ctx->status = spdk_bdev_io_set_base_io_status(orig_io, bdev_io);
+
+	if (bdev_io->type == SPDK_BDEV_IO_TYPE_ZCOPY && bdev_io->u.bdev.zcopy.start && success) {
+		io_ctx->zcopy_bdev_io = bdev_io;
+	} else {
+		assert(io_ctx->zcopy_bdev_io == NULL || io_ctx->zcopy_bdev_io == bdev_io);
+		io_ctx->zcopy_bdev_io = NULL;
+		spdk_bdev_free_io(bdev_io);
+	}
+
+	if (io_ctx->is_slow) {
+		io_ctx->completion_tick = spdk_get_ticks() + node->slow_ticks;
+		STAILQ_INSERT_TAIL(&ch->slow_ios, io_ctx, link);
+	} else {
+		io_ctx->completion_tick = spdk_get_ticks() + node->fast_ticks;
+		STAILQ_INSERT_TAIL(&ch->fast_ios, io_ctx, link);
+	}
+}
+
+/* ---- resubmit on ENOMEM ---- */
+static void vbdev_bimodal_submit_request(struct spdk_io_channel *ch, struct spdk_bdev_io *bdev_io);
+
+static void
+vbdev_bimodal_resubmit(void *arg)
+{
+	struct spdk_bdev_io *bdev_io = arg;
+	struct bimodal_io *io_ctx = (struct bimodal_io *)bdev_io->driver_ctx;
+
+	vbdev_bimodal_submit_request(io_ctx->ch, bdev_io);
+}
+
+static void
+vbdev_bimodal_queue_io(struct spdk_bdev_io *bdev_io)
+{
+	struct bimodal_io *io_ctx = (struct bimodal_io *)bdev_io->driver_ctx;
+	struct bimodal_ch *ch = spdk_io_channel_get_ctx(io_ctx->ch);
+	int rc;
+
+	io_ctx->bdev_io_wait.bdev = bdev_io->bdev;
+	io_ctx->bdev_io_wait.cb_fn = vbdev_bimodal_resubmit;
+	io_ctx->bdev_io_wait.cb_arg = bdev_io;
+
+	rc = spdk_bdev_queue_io_wait(bdev_io->bdev, ch->base_ch, &io_ctx->bdev_io_wait);
+	if (rc != 0) {
+		SPDK_ERRLOG("Queue io failed in vbdev_bimodal_queue_io, rc=%d.\n", rc);
+		spdk_bdev_io_complete(bdev_io, SPDK_BDEV_IO_STATUS_FAILED);
+	}
+}
+
+static void
+bimodal_read_get_buf_cb(struct spdk_io_channel *ch, struct spdk_bdev_io *bdev_io, bool success)
+{
+	struct vbdev_bimodal *node = SPDK_CONTAINEROF(bdev_io->bdev, struct vbdev_bimodal, bdev);
+	struct bimodal_ch *bch = spdk_io_channel_get_ctx(ch);
+	int rc;
+
+	if (!success) {
+		spdk_bdev_io_complete(bdev_io, SPDK_BDEV_IO_STATUS_FAILED);
+		return;
+	}
+
+	rc = spdk_bdev_readv_blocks(node->base_desc, bch->base_ch,
+				    bdev_io->u.bdev.iovs, bdev_io->u.bdev.iovcnt,
+				    bdev_io->u.bdev.offset_blocks,
+				    bdev_io->u.bdev.num_blocks,
+				    _bimodal_complete_io, bdev_io);
+	if (rc == -ENOMEM) {
+		vbdev_bimodal_queue_io(bdev_io);
+	} else if (rc != 0) {
+		SPDK_ERRLOG("bimodal_delay: readv failed rc=%d\n", rc);
+		spdk_bdev_io_complete(bdev_io, SPDK_BDEV_IO_STATUS_FAILED);
+	}
+}
+
+static void
+vbdev_bimodal_submit_request(struct spdk_io_channel *ch, struct spdk_bdev_io *bdev_io)
+{
+	struct vbdev_bimodal *node = SPDK_CONTAINEROF(bdev_io->bdev, struct vbdev_bimodal, bdev);
+	struct bimodal_ch *bch = spdk_io_channel_get_ctx(ch);
+	struct bimodal_io *io_ctx = (struct bimodal_io *)bdev_io->driver_ctx;
+	int rc = 0;
+
+	io_ctx->ch = ch;
+	io_ctx->is_slow = is_slow_io(bch, node->p_slow_ppm);
+	if (bdev_io->type != SPDK_BDEV_IO_TYPE_ZCOPY || bdev_io->u.bdev.zcopy.start) {
+		io_ctx->zcopy_bdev_io = NULL;
+	}
+
+	switch (bdev_io->type) {
+	case SPDK_BDEV_IO_TYPE_READ:
+		spdk_bdev_io_get_buf(bdev_io, bimodal_read_get_buf_cb,
+				     bdev_io->u.bdev.num_blocks * bdev_io->bdev->blocklen);
+		return;
+
+	case SPDK_BDEV_IO_TYPE_WRITE:
+		rc = spdk_bdev_writev_blocks(node->base_desc, bch->base_ch,
+					     bdev_io->u.bdev.iovs, bdev_io->u.bdev.iovcnt,
+					     bdev_io->u.bdev.offset_blocks,
+					     bdev_io->u.bdev.num_blocks,
+					     _bimodal_complete_io, bdev_io);
+		break;
+
+	case SPDK_BDEV_IO_TYPE_WRITE_ZEROES:
+		rc = spdk_bdev_write_zeroes_blocks(node->base_desc, bch->base_ch,
+						   bdev_io->u.bdev.offset_blocks,
+						   bdev_io->u.bdev.num_blocks,
+						   _bimodal_complete_io, bdev_io);
+		break;
+
+	case SPDK_BDEV_IO_TYPE_UNMAP:
+		rc = spdk_bdev_unmap_blocks(node->base_desc, bch->base_ch,
+					    bdev_io->u.bdev.offset_blocks,
+					    bdev_io->u.bdev.num_blocks,
+					    _bimodal_complete_io, bdev_io);
+		break;
+
+	case SPDK_BDEV_IO_TYPE_FLUSH:
+		rc = spdk_bdev_flush_blocks(node->base_desc, bch->base_ch,
+					    bdev_io->u.bdev.offset_blocks,
+					    bdev_io->u.bdev.num_blocks,
+					    _bimodal_complete_io, bdev_io);
+		break;
+
+	case SPDK_BDEV_IO_TYPE_RESET:
+		/* Abort all deferred IOs then forward reset to base. */
+		{
+			struct bimodal_io *tmp_ctx, *tmp_next;
+			STAILQ_FOREACH_SAFE(tmp_ctx, &bch->fast_ios, link, tmp_next) {
+				STAILQ_REMOVE(&bch->fast_ios, tmp_ctx, bimodal_io, link);
+				spdk_bdev_io_complete(spdk_bdev_io_from_ctx(tmp_ctx),
+						      SPDK_BDEV_IO_STATUS_ABORTED);
+			}
+			STAILQ_FOREACH_SAFE(tmp_ctx, &bch->slow_ios, link, tmp_next) {
+				STAILQ_REMOVE(&bch->slow_ios, tmp_ctx, bimodal_io, link);
+				spdk_bdev_io_complete(spdk_bdev_io_from_ctx(tmp_ctx),
+						      SPDK_BDEV_IO_STATUS_ABORTED);
+			}
+			rc = spdk_bdev_reset(node->base_desc, bch->base_ch,
+					     _bimodal_complete_io, bdev_io);
+		}
+		break;
+
+	case SPDK_BDEV_IO_TYPE_ZCOPY:
+		if (bdev_io->u.bdev.zcopy.start) {
+			rc = spdk_bdev_zcopy_start(node->base_desc, bch->base_ch,
+						   bdev_io->u.bdev.iovs, bdev_io->u.bdev.iovcnt,
+						   bdev_io->u.bdev.offset_blocks,
+						   bdev_io->u.bdev.num_blocks,
+						   bdev_io->u.bdev.zcopy.populate,
+						   _bimodal_complete_io, bdev_io);
+		} else {
+			rc = spdk_bdev_zcopy_end(io_ctx->zcopy_bdev_io,
+						 bdev_io->u.bdev.zcopy.commit,
+						 _bimodal_complete_io, bdev_io);
+		}
+		break;
+
+	default:
+		SPDK_ERRLOG("bimodal_delay: unknown IO type %d\n", bdev_io->type);
+		spdk_bdev_io_complete(bdev_io, SPDK_BDEV_IO_STATUS_FAILED);
+		return;
+	}
+
+	if (rc == -ENOMEM) {
+		vbdev_bimodal_queue_io(bdev_io);
+	} else if (rc != 0) {
+		SPDK_ERRLOG("bimodal_delay: IO submission failed rc=%d\n", rc);
+		spdk_bdev_io_complete(bdev_io, SPDK_BDEV_IO_STATUS_FAILED);
+	}
+}
+
+static bool
+vbdev_bimodal_io_type_supported(void *ctx, enum spdk_bdev_io_type io_type)
+{
+	struct vbdev_bimodal *node = ctx;
+
+	if (io_type == SPDK_BDEV_IO_TYPE_NVME_ADMIN) {
+		return false;
+	}
+	return spdk_bdev_io_type_supported(node->base_bdev, io_type);
+}
+
+static struct spdk_io_channel *
+vbdev_bimodal_get_io_channel(void *ctx)
+{
+	struct vbdev_bimodal *node = ctx;
+
+	return spdk_get_io_channel(node);
+}
+
+static int
+vbdev_bimodal_dump_info_json(void *ctx, struct spdk_json_write_ctx *w)
+{
+	struct vbdev_bimodal *node = ctx;
+	uint64_t hz = spdk_get_ticks_hz();
+
+	spdk_json_write_name(w, "bimodal_delay");
+	spdk_json_write_object_begin(w);
+	spdk_json_write_named_string(w, "name", spdk_bdev_get_name(&node->bdev));
+	spdk_json_write_named_string(w, "base_bdev_name", spdk_bdev_get_name(node->base_bdev));
+	spdk_json_write_named_uint64(w, "fast_lat_us",
+				     node->fast_ticks * SPDK_SEC_TO_USEC / hz);
+	spdk_json_write_named_uint64(w, "slow_lat_us",
+				     node->slow_ticks * SPDK_SEC_TO_USEC / hz);
+	spdk_json_write_named_uint32(w, "p_slow_ppm", node->p_slow_ppm);
+	spdk_json_write_object_end(w);
+	return 0;
+}
+
+static void
+vbdev_bimodal_write_config_json(struct spdk_bdev *bdev, struct spdk_json_write_ctx *w)
+{
+	/* per-bdev config written from vbdev_bimodal_config_json */
+}
+
+static int
+vbdev_bimodal_get_memory_domains(void *ctx, struct spdk_memory_domain **domains, int array_size)
+{
+	struct vbdev_bimodal *node = ctx;
+
+	return spdk_bdev_get_memory_domains(node->base_bdev, domains, array_size);
+}
+
+static int
+vbdev_bimodal_get_memory_domain_types(void *ctx, enum spdk_dma_device_type *types,
+				      uint32_t array_size)
+{
+	struct vbdev_bimodal *node = ctx;
+
+	return spdk_bdev_get_memory_domain_types(node->base_bdev, types, array_size);
+}
+
+static void
+_bimodal_device_unregister_cb(void *io_device)
+{
+	struct vbdev_bimodal *node = io_device;
+
+	free(node->bdev.name);
+	free(node);
+}
+
+static int
+vbdev_bimodal_destruct(void *ctx)
+{
+	struct vbdev_bimodal *node = ctx;
+
+	TAILQ_REMOVE(&g_bimodal_nodes, node, link);
+	spdk_bdev_module_release_bdev(node->base_bdev);
+
+	if (node->thread && node->thread != spdk_get_thread()) {
+		spdk_thread_send_msg(node->thread,
+				     (spdk_msg_fn)spdk_bdev_close, node->base_desc);
+	} else {
+		spdk_bdev_close(node->base_desc);
+	}
+
+	spdk_io_device_unregister(node, _bimodal_device_unregister_cb);
+	return 0;
+}
+
+static const struct spdk_bdev_fn_table vbdev_bimodal_fn_table = {
+	.destruct              = vbdev_bimodal_destruct,
+	.submit_request        = vbdev_bimodal_submit_request,
+	.io_type_supported     = vbdev_bimodal_io_type_supported,
+	.get_io_channel        = vbdev_bimodal_get_io_channel,
+	.dump_info_json        = vbdev_bimodal_dump_info_json,
+	.write_config_json     = vbdev_bimodal_write_config_json,
+	.get_memory_domains    = vbdev_bimodal_get_memory_domains,
+	.get_memory_domain_types = vbdev_bimodal_get_memory_domain_types,
+};
+
+/* ---- IO channel callbacks ---- */
+static int
+bimodal_ch_create_cb(void *io_device, void *ctx_buf)
+{
+	struct bimodal_ch *ch = ctx_buf;
+	struct vbdev_bimodal *node = io_device;
+
+	STAILQ_INIT(&ch->fast_ios);
+	STAILQ_INIT(&ch->slow_ios);
+	/* Seed: mix thread pointer bits with time to avoid correlated streams. */
+	ch->rng = (uint64_t)(uintptr_t)spdk_get_thread() ^ (uint64_t)spdk_get_ticks();
+	if (ch->rng == 0) {
+		ch->rng = 0xdeadbeefcafe1337ULL;
+	}
+
+	ch->poller  = SPDK_POLLER_REGISTER(_bimodal_finish_io, ch, 0);
+	ch->base_ch = spdk_bdev_get_io_channel(node->base_desc);
+	return 0;
+}
+
+static void
+bimodal_ch_destroy_cb(void *io_device, void *ctx_buf)
+{
+	struct bimodal_ch *ch = ctx_buf;
+
+	spdk_poller_unregister(&ch->poller);
+	spdk_put_io_channel(ch->base_ch);
+}
+
+/* ---- base bdev event ---- */
+static void
+vbdev_bimodal_base_bdev_event_cb(enum spdk_bdev_event_type type, struct spdk_bdev *bdev,
+				  void *event_ctx)
+{
+	struct vbdev_bimodal *node, *tmp;
+
+	if (type == SPDK_BDEV_EVENT_REMOVE) {
+		TAILQ_FOREACH_SAFE(node, &g_bimodal_nodes, link, tmp) {
+			if (bdev == node->base_bdev) {
+				spdk_bdev_unregister(&node->bdev, NULL, NULL);
+			}
+		}
+	}
+}
+
+/* ---- registration ---- */
+static int
+vbdev_bimodal_register(const char *bdev_name)
+{
+	struct bimodal_association *assoc;
+	struct vbdev_bimodal *node;
+	struct spdk_bdev *bdev;
+	uint64_t ticks_mhz = spdk_get_ticks_hz() / SPDK_SEC_TO_USEC;
+	struct spdk_uuid ns_uuid;
+	int rc = 0;
+
+	spdk_uuid_parse(&ns_uuid, BDEV_BIMODAL_NAMESPACE_UUID);
+
+	TAILQ_FOREACH(assoc, &g_assoc, link) {
+		if (strcmp(assoc->bdev_name, bdev_name) != 0) {
+			continue;
+		}
+
+		node = calloc(1, sizeof(*node));
+		if (!node) {
+			rc = -ENOMEM;
+			break;
+		}
+
+		node->bdev.name = strdup(assoc->vbdev_name);
+		if (!node->bdev.name) {
+			free(node);
+			rc = -ENOMEM;
+			break;
+		}
+		node->bdev.product_name = "bimodal_delay";
+
+		rc = spdk_bdev_open_ext(bdev_name, true, vbdev_bimodal_base_bdev_event_cb,
+					NULL, &node->base_desc);
+		if (rc) {
+			if (rc != -ENODEV) {
+				SPDK_ERRLOG("bimodal_delay: could not open bdev %s\n", bdev_name);
+			}
+			free(node->bdev.name);
+			free(node);
+			break;
+		}
+
+		bdev = spdk_bdev_desc_get_bdev(node->base_desc);
+		node->base_bdev = bdev;
+
+		node->bdev.write_cache         = bdev->write_cache;
+		node->bdev.required_alignment  = bdev->required_alignment;
+		node->bdev.optimal_io_boundary = bdev->optimal_io_boundary;
+		node->bdev.blocklen            = bdev->blocklen;
+		node->bdev.blockcnt            = bdev->blockcnt;
+		node->bdev.md_interleave       = bdev->md_interleave;
+		node->bdev.md_len              = bdev->md_len;
+		node->bdev.dif_type            = bdev->dif_type;
+		node->bdev.dif_is_head_of_md   = bdev->dif_is_head_of_md;
+		node->bdev.dif_check_flags     = bdev->dif_check_flags;
+		node->bdev.dif_pi_format       = bdev->dif_pi_format;
+		node->bdev.ctxt                = node;
+		node->bdev.fn_table            = &vbdev_bimodal_fn_table;
+		node->bdev.module              = &bimodal_if;
+		node->bdev.numa                = bdev->numa;
+
+		node->fast_ticks  = ticks_mhz * assoc->fast_lat_us;
+		node->slow_ticks  = ticks_mhz * assoc->slow_lat_us;
+		node->p_slow_ppm  = assoc->p_slow_ppm;
+
+		if (spdk_uuid_is_null(&assoc->uuid)) {
+			rc = spdk_uuid_generate_sha1(&node->bdev.uuid, &ns_uuid,
+						     (const char *)&bdev->uuid,
+						     sizeof(struct spdk_uuid));
+			if (rc) {
+				spdk_bdev_close(node->base_desc);
+				free(node->bdev.name);
+				free(node);
+				break;
+			}
+		} else {
+			spdk_uuid_copy(&node->bdev.uuid, &assoc->uuid);
+		}
+
+		spdk_io_device_register(node, bimodal_ch_create_cb, bimodal_ch_destroy_cb,
+					sizeof(struct bimodal_ch), assoc->vbdev_name);
+		node->thread = spdk_get_thread();
+
+		rc = spdk_bdev_module_claim_bdev(bdev, node->base_desc, &bimodal_if);
+		if (rc) {
+			SPDK_ERRLOG("bimodal_delay: could not claim bdev %s\n", bdev_name);
+			goto err_close;
+		}
+
+		rc = spdk_bdev_register(&node->bdev);
+		if (rc) {
+			SPDK_ERRLOG("bimodal_delay: could not register bdev\n");
+			spdk_bdev_module_release_bdev(node->base_bdev);
+			goto err_close;
+		}
+
+		TAILQ_INSERT_TAIL(&g_bimodal_nodes, node, link);
+	}
+
+	return rc;
+
+err_close:
+	spdk_bdev_close(node->base_desc);
+	spdk_io_device_unregister(node, NULL);
+	free(node->bdev.name);
+	free(node);
+	return rc;
+}
+
+int
+create_bimodal_delay_disk(const char *bdev_name, const char *vbdev_name,
+			  struct spdk_uuid *uuid,
+			  uint64_t fast_lat_us, uint64_t slow_lat_us,
+			  uint32_t p_slow_ppm)
+{
+	struct bimodal_association *assoc;
+	int rc = 0;
+
+	if (slow_lat_us < fast_lat_us) {
+		SPDK_ERRLOG("bimodal_delay: slow_lat_us must be >= fast_lat_us\n");
+		return -EINVAL;
+	}
+	if (p_slow_ppm > 1000000) {
+		SPDK_ERRLOG("bimodal_delay: p_slow_ppm must be <= 1000000\n");
+		return -EINVAL;
+	}
+
+	TAILQ_FOREACH(assoc, &g_assoc, link) {
+		if (strcmp(assoc->vbdev_name, vbdev_name) == 0) {
+			SPDK_ERRLOG("bimodal_delay bdev %s already exists\n", vbdev_name);
+			return -EEXIST;
+		}
+	}
+
+	assoc = calloc(1, sizeof(*assoc));
+	if (!assoc) {
+		return -ENOMEM;
+	}
+
+	assoc->bdev_name = strdup(bdev_name);
+	assoc->vbdev_name = strdup(vbdev_name);
+	if (!assoc->bdev_name || !assoc->vbdev_name) {
+		free(assoc->bdev_name);
+		free(assoc->vbdev_name);
+		free(assoc);
+		return -ENOMEM;
+	}
+
+	assoc->fast_lat_us  = fast_lat_us;
+	assoc->slow_lat_us  = slow_lat_us;
+	assoc->p_slow_ppm   = p_slow_ppm;
+	if (uuid) {
+		spdk_uuid_copy(&assoc->uuid, uuid);
+	}
+
+	TAILQ_INSERT_TAIL(&g_assoc, assoc, link);
+
+	rc = vbdev_bimodal_register(bdev_name);
+	if (rc == -ENODEV) {
+		SPDK_NOTICELOG("bimodal_delay: deferred (base bdev not found yet)\n");
+		rc = 0;
+	}
+	return rc;
+}
+
+void
+delete_bimodal_delay_disk(const char *vbdev_name, spdk_bdev_unregister_cb cb_fn, void *cb_arg)
+{
+	struct bimodal_association *assoc;
+	int rc;
+
+	rc = spdk_bdev_unregister_by_name(vbdev_name, &bimodal_if, cb_fn, cb_arg);
+	if (rc == 0) {
+		TAILQ_FOREACH(assoc, &g_assoc, link) {
+			if (strcmp(assoc->vbdev_name, vbdev_name) == 0) {
+				TAILQ_REMOVE(&g_assoc, assoc, link);
+				free(assoc->bdev_name);
+				free(assoc->vbdev_name);
+				free(assoc);
+				break;
+			}
+		}
+	} else {
+		cb_fn(cb_arg, rc);
+	}
+}
+
+int
+update_bimodal_delay_disk(const char *vbdev_name,
+			  uint64_t fast_lat_us, uint64_t slow_lat_us,
+			  uint32_t p_slow_ppm)
+{
+	struct vbdev_bimodal *node;
+	uint64_t ticks_mhz = spdk_get_ticks_hz() / SPDK_SEC_TO_USEC;
+
+	TAILQ_FOREACH(node, &g_bimodal_nodes, link) {
+		if (strcmp(node->bdev.name, vbdev_name) == 0) {
+			if (fast_lat_us > 0) {
+				node->fast_ticks = ticks_mhz * fast_lat_us;
+			}
+			if (slow_lat_us > 0) {
+				node->slow_ticks = ticks_mhz * slow_lat_us;
+			}
+			if (p_slow_ppm != UINT32_MAX) {
+				if (p_slow_ppm > 1000000) {
+					return -EINVAL;
+				}
+				node->p_slow_ppm = p_slow_ppm;
+			}
+			return 0;
+		}
+	}
+	return -ENODEV;
+}
+
+/* ---- module lifecycle ---- */
+static int
+vbdev_bimodal_init(void)
+{
+	return 0;
+}
+
+static void
+vbdev_bimodal_finish(void)
+{
+	struct bimodal_association *assoc;
+
+	while ((assoc = TAILQ_FIRST(&g_assoc))) {
+		TAILQ_REMOVE(&g_assoc, assoc, link);
+		free(assoc->bdev_name);
+		free(assoc->vbdev_name);
+		free(assoc);
+	}
+}
+
+static int
+vbdev_bimodal_get_ctx_size(void)
+{
+	return sizeof(struct bimodal_io);
+}
+
+static void
+vbdev_bimodal_examine(struct spdk_bdev *bdev)
+{
+	struct bimodal_association *assoc;
+
+	TAILQ_FOREACH(assoc, &g_assoc, link) {
+		if (strcmp(assoc->bdev_name, bdev->name) == 0) {
+			vbdev_bimodal_register(bdev->name);
+			break;
+		}
+	}
+	spdk_bdev_module_examine_done(&bimodal_if);
+}
+
+static int
+vbdev_bimodal_config_json(struct spdk_json_write_ctx *w)
+{
+	struct vbdev_bimodal *node;
+	uint64_t hz = spdk_get_ticks_hz();
+
+	TAILQ_FOREACH(node, &g_bimodal_nodes, link) {
+		spdk_json_write_object_begin(w);
+		spdk_json_write_named_string(w, "method", "bdev_bimodal_delay_create");
+		spdk_json_write_named_object_begin(w, "params");
+		spdk_json_write_named_string(w, "name", spdk_bdev_get_name(&node->bdev));
+		spdk_json_write_named_string(w, "base_bdev_name",
+					     spdk_bdev_get_name(node->base_bdev));
+		spdk_json_write_named_uint64(w, "fast_lat_us",
+					     node->fast_ticks * SPDK_SEC_TO_USEC / hz);
+		spdk_json_write_named_uint64(w, "slow_lat_us",
+					     node->slow_ticks * SPDK_SEC_TO_USEC / hz);
+		spdk_json_write_named_uint32(w, "p_slow_ppm", node->p_slow_ppm);
+		spdk_json_write_object_end(w);
+		spdk_json_write_object_end(w);
+	}
+	return 0;
+}
diff --git a/module/bdev/bimodal_delay/vbdev_bimodal_delay.h b/module/bdev/bimodal_delay/vbdev_bimodal_delay.h
new file mode 100644
index 000000000..65d674218
--- /dev/null
+++ b/module/bdev/bimodal_delay/vbdev_bimodal_delay.h
@@ -0,0 +1,48 @@
+/*   SPDX-License-Identifier: BSD-3-Clause
+ *   Bimodal delay bdev for D4 experiment — probabilistic fast/slow injection.
+ *   85% IO uses fast_lat_us, 15% uses slow_lat_us (configurable via p_slow).
+ */
+
+#ifndef SPDK_VBDEV_BIMODAL_DELAY_H
+#define SPDK_VBDEV_BIMODAL_DELAY_H
+
+#include "spdk/stdinc.h"
+#include "spdk/bdev.h"
+#include "spdk/bdev_module.h"
+
+/**
+ * Create a bimodal delay bdev.
+ *
+ * \param base_bdev_name   Base bdev name.
+ * \param vbdev_name       Name for this virtual bdev.
+ * \param uuid             Optional UUID (NULL-UUID = auto-generate).
+ * \param fast_lat_us      Fast branch latency in microseconds (85% path).
+ * \param slow_lat_us      Slow branch latency in microseconds (15% path).
+ * \param p_slow_ppm       Probability of slow path, in parts-per-million
+ *                         (e.g. 150000 = 15.0%).
+ * \return 0 on success, negative errno on failure.
+ */
+int create_bimodal_delay_disk(const char *base_bdev_name, const char *vbdev_name,
+			      struct spdk_uuid *uuid,
+			      uint64_t fast_lat_us, uint64_t slow_lat_us,
+			      uint32_t p_slow_ppm);
+
+/**
+ * Delete a bimodal delay bdev.
+ */
+void delete_bimodal_delay_disk(const char *vbdev_name, spdk_bdev_unregister_cb cb_fn,
+			       void *cb_arg);
+
+/**
+ * Update parameters at runtime (for D2 fail-slow onset simulation).
+ *
+ * \param vbdev_name  Name of the bimodal delay bdev.
+ * \param fast_lat_us New fast latency (0 = keep existing).
+ * \param slow_lat_us New slow latency (0 = keep existing).
+ * \param p_slow_ppm  New slow probability in ppm (UINT32_MAX = keep existing).
+ */
+int update_bimodal_delay_disk(const char *vbdev_name,
+			      uint64_t fast_lat_us, uint64_t slow_lat_us,
+			      uint32_t p_slow_ppm);
+
