module/bdev/error/vbdev_error_rpc.c
  @@ -153,3 +153,75 @@ cleanup:
  +
  +/*
  + * bdev_error_inject_nvme_error — inject a specific NVMe sct/sc status code.
  + *
  + * This is a separate, lighter RPC that bypasses the autogen enum system and
  + * lets callers specify numeric sct + sc directly.  Used by D3 experiment to
  + * distinguish media errors (sct=2/sc=0x81) from path errors (sct=3/sc=0x00).
  + *
  + * Example:
  + *   rpc.py bdev_error_inject_nvme_error --name EE_Null0 \
  + *          --io_type read --num 1000 --sct 2 --sc 0x81
  + */
  +struct rpc_bdev_nvme_inject_ctx {
  +	char		*name;
  +	uint32_t	io_type;   /* decoded via rpc_error_bdev_decode_io_type */
  +	uint32_t	num;
  +	uint64_t	queue_depth;
  +	uint8_t		sct;
  +	uint8_t		sc;
  +};
  +
  +static void
  +free_rpc_bdev_nvme_inject(struct rpc_bdev_nvme_inject_ctx *r)
  +{
  +	free(r->name);
  +}
  +
  +static const struct spdk_json_object_decoder rpc_bdev_error_inject_nvme_error_decoders[] = {
  +	{"name",        offsetof(struct rpc_bdev_nvme_inject_ctx, name),        spdk_json_decode_string},
  +	{"io_type",     offsetof(struct rpc_bdev_nvme_inject_ctx, io_type),     rpc_error_bdev_decode_io_type},
  +	{"num",         offsetof(struct rpc_bdev_nvme_inject_ctx, num),         spdk_json_decode_uint32, true},
  +	{"queue_depth", offsetof(struct rpc_bdev_nvme_inject_ctx, queue_depth), spdk_json_decode_uint64, true},
  +	{"sct",         offsetof(struct rpc_bdev_nvme_inject_ctx, sct),         spdk_json_decode_uint8},
  +	{"sc",          offsetof(struct rpc_bdev_nvme_inject_ctx, sc),          spdk_json_decode_uint8},
  +};
  +
  +static void
  +rpc_bdev_error_inject_nvme_error(struct spdk_jsonrpc_request *request,
  +				 const struct spdk_json_val *params)
  +{
  +	struct rpc_bdev_nvme_inject_ctx req = {.num = 1};
  +	struct vbdev_error_inject_opts opts = {};
  +	int rc = 0;
  +
  +	if (spdk_json_decode_object(params, rpc_bdev_error_inject_nvme_error_decoders,
  +				    SPDK_COUNTOF(rpc_bdev_error_inject_nvme_error_decoders), &req)) {
  +		SPDK_ERRLOG("spdk_json_decode_object failed\n");
  +		spdk_jsonrpc_send_error_response(request, SPDK_JSONRPC_ERROR_INTERNAL_ERROR,
  +						 "spdk_json_decode_object failed");
  +		goto cleanup;
  +	}
  +
  +	opts.io_type    = req.io_type;
  +	opts.error_type = VBDEV_IO_NVME_ERROR;
  +	opts.error_num  = req.num;
  +	opts.error_qd   = req.queue_depth;
  +	opts.nvme_sct   = req.sct;
  +	opts.nvme_sc    = req.sc;
  +
  +	rc = vbdev_error_inject_error(req.name, &opts);
  +	if (rc) {
  +		spdk_jsonrpc_send_error_response(request, rc, spdk_strerror(-rc));
  +		goto cleanup;
  +	}
  +
  +	spdk_jsonrpc_send_bool_response(request, true);
  +
  +cleanup:
  +	free_rpc_bdev_nvme_inject(&req);
  +}
  +SPDK_RPC_REGISTER("bdev_error_inject_nvme_error", rpc_bdev_error_inject_nvme_error,
  +		  SPDK_RPC_RUNTIME)
