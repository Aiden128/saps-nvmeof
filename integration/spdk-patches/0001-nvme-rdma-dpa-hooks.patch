  @@ -1339,9 +1339,75 @@ _bdev_nvme_find_io_path_min_qd(struct nvme_bdev_channel *nbdev_ch)
  +/* DPA plugin path-selection hook counter.
  + * Incremented once per IO when POLICY_PLUGIN is active.
  + * Exposed as g_dpa_plugin_select_count for external visibility (e.g. RPC dump).
  + * Not protected by a lock — used on a single reactor thread per bdev channel,
  + * so the per-call increment is data-race-free within one thread. Cross-thread
  + * totals can be read non-atomically for telemetry (approximate is fine). */
  +uint64_t g_dpa_plugin_select_count = 0;
  +uint64_t g_dpa_plugin_select_fallback = 0;  /* incremented when no path scored */
  +
  +#ifdef DPA_PLUGIN_ENABLED
  +#include "dpa_plugin.h"
  +#endif
  +
  +/* S3 SAPS-single path-selector.
  + *
  + * Iterates the bdev channel's io_path_list, reads DPA-computed score for each
  + * path via (qp_id, path_idx), returns argmax. DPA writes scores through
  + * per_qp_path_score[qp][path] (see dpa_plugin_dev.c saps_update). Path index
  + * is the walk position within io_path_list — must match the path_id injected
  + * by the nvme_rdma.c submit/complete hooks. Current injection uses
  + * qp_id & PATH_MASK as surrogate (TODO: proper io_path index threaded through
  + * spdk_bdev_io private field), so here we also use the same surrogate key
  + * rather than the walk position so reader/writer agree.
  + *
  + * Fallback: if DPA plugin isn't linked (build-time) or no path has a non-zero
  + * score yet (warmup), return STAILQ_FIRST — same behaviour as the S2 stub. */
  +static inline struct nvme_io_path *
  +dpa_plugin_select_io_path(struct nvme_bdev_channel *nbdev_ch)
  +{
  +	g_dpa_plugin_select_count++;
  +
  +#ifdef DPA_PLUGIN_ENABLED
  +	struct nvme_io_path *io_path;
  +	struct nvme_io_path *best = NULL;
  +	uint32_t best_score = 0;
  +
  +	STAILQ_FOREACH(io_path, &nbdev_ch->io_path_list, stailq) {
  +		struct spdk_nvme_qpair *spdk_qp = io_path->qpair->qpair;
  +		if (!spdk_qp) {
  +			continue;
  +		}
  +		uint16_t qp_id = spdk_nvme_qpair_get_id(spdk_qp);
  +		/* path_id must match the surrogate used in nvme_rdma.c hooks:
  +		 * (qp_id & DPA_PLUGIN_PATH_MASK). Each path owns a distinct
  +		 * qpair on this channel so the surrogate still buckets them
  +		 * separately within PATH_MAX=4 slots. */
  +		uint16_t path_id = (uint16_t)(qp_id & 0x3u);
  +		uint32_t score = dpa_plugin_read_path_score(qp_id, path_id);
  +		if (score > best_score) {
  +			best_score = score;
  +			best = io_path;
  +		}
  +	}
  +
  +	if (best) {
  +		return best;
  +	}
  +	g_dpa_plugin_select_fallback++;
  +#endif
  +	return STAILQ_FIRST(&nbdev_ch->io_path_list);
  +}
  +
   static inline struct nvme_io_path *
   bdev_nvme_find_io_path(struct nvme_bdev_channel *nbdev_ch)
   {
  +	if (nbdev_ch->mp_policy == SPDK_BDEV_NVME_MULTIPATH_POLICY_PLUGIN) {
  +		return dpa_plugin_select_io_path(nbdev_ch);
  +	}
  +
   	if (spdk_likely(nbdev_ch->current_io_path != NULL)) {
   		if (nbdev_ch->mp_policy == SPDK_BDEV_NVME_MULTIPATH_POLICY_ACTIVE_PASSIVE) {
   			return nbdev_ch->current_io_path;
  @@ -4294,6 +4360,8 @@ bdev_nvme_multipath_policy_str(enum spdk_bdev_nvme_multipath_policy policy)
